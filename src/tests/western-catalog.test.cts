const a=c.api,s=a.defaults(),added=a.WESTERN_HEALTHY_RECIPES;assert.equal(a.RECIPES.length,740);assert.equal(Object.keys(a.INGREDIENTS).length,106);assert.equal(added.length,100);assert.equal(new Set(a.RECIPES.map(r=>r.name)).size,740);assert.equal(new Set(a.RECIPES.map(r=>r.id)).size,740);
