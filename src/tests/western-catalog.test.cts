const meal={recipes:[structuredClone(added.find(r=>r.method==='risotto'))],attendance:{dad:'home'},servings:4,staple:'auto'};assert.equal(a.mealHasRice(meal),false);assert.ok(!a.mealIngredients(meal,s).rice);assert.equal(a.mealHasRice({...meal,staple:'rice'}),true);const copy=structuredClone(meal);delete copy.recipes[0].stapleIncluded;assert.equal(a.mealHasRice(copy),false,'authored copy with grain does not add a second rice portion');
