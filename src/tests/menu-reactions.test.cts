// v1.7.1 Menu reactions: storage + two-device merge, preference model (score, affinity, fatigue), planner ranking and
// explanations, on-behalf reactions. Runs the real frontend scripts in a VM (no DOM).
const fs=require('fs'),vm=require('vm'),assert=require('node:assert/strict');
const c=vm.createContext({console,Intl,Date,Math,URL,structuredClone,crypto:require('node:crypto').webcrypto});
for(const f of ['store-registry.js','seed.js','recipe-catalog.js','core.js','spending-core.js','purchase-units.js','planning-core.js','insights-core.js','family-menu-core.js','availability-core.js','menu-reactions-core.js'])vm.runInContext(fs.readFileSync('dist/'+f,'utf8'),c);
const run=(code:string)=>vm.runInContext(code,c);
let passed=0;const test=(name:string,fn:()=>void)=>{try{fn();passed++}catch(e){console.error('FAIL',name);throw e}};
run(`globalThis.mk=()=>{const s=defaults();s.weeks={};s.pantry=[];s.recipes=[];const add=(id,name,cat,protein,ings,purposes)=>s.recipes.push({...recipe(id,name,cat,protein,20,ings,'prep',['cook']),custom:true,purposes,yield:4});
 add('m1','Gà xào sả ớt','main','chicken',{chicken:400,lemongrass:20},['main']);add('m2','Thịt kho trứng','main','pork',{pork:400,egg:4},['main']);add('m3','Cá kho tộ','main','fish',{fish:400},['main']);
 add('m4','Bò xào cay','main','beef',{beef:300},['main']);add('m5','Gà luộc','main','chicken',{chicken:500},['main']);return s}`);
test('toggle, history, reasons and on-behalf',()=>run(`(()=>{const s=mk(),r=s.recipes[0];
 let e=toggleMenuReaction(s,'little',r,'dislike',{date:'2026-11-02',by:'mum',at:1000});if(e.v!=='dislike'||e.by!=='mum'||e.d!=='2026-11-02'||e.n!=='Gà xào sả ớt')throw Error('dislike on behalf');
 e=setMenuReactionReasons(s,'little',r,['spicy','bogus'],{by:'mum',at:1001});if(JSON.stringify(e.why)!=='["spicy"]')throw Error('reason whitelist');
 e=toggleMenuReaction(s,'little',r,'dislike',{date:'2026-11-02',at:1002});if(e.v!=='none'||e.why.length)throw Error('second tap clears');
 e=toggleMenuReaction(s,'little',r,'like',{date:'2026-11-03',at:1003});if(e.v!=='like'||e.h.map(x=>x.v).join()!=='dislike,none,like')throw Error('history '+JSON.stringify(e.h));
 e=toggleMenuReaction(s,'little',r,'like',{date:'2026-11-03',at:5});if(e.at<=1003)throw Error('timestamps never go backwards');
 let threw=false;try{toggleMenuReaction(s,'stranger',r,'like')}catch{threw=true}if(!threw)throw Error('unknown member rejected');
 if(s.recipes[0].name!=='Gà xào sả ớt'||JSON.stringify(s.recipes[0].ingredients)!=='[{"id":"chicken","qty":400},{"id":"lemongrass","qty":20}]')throw Error('recipe untouched');
 if(!validImport(s)||!validMenuReactionState(s))throw Error('valid state');})()`));
test('two offline devices merge per member+dish, last write wins, commutative',()=>run(`(()=>{const base=mk(),[m1,m2,m3]=base.recipes;toggleMenuReaction(base,'dad',m1,'like',{date:'2026-11-01',at:100});
 const A=JSON.parse(JSON.stringify(base)),B=JSON.parse(JSON.stringify(base));
 toggleMenuReaction(A,'little',m2,'dislike',{date:'2026-11-02',at:200});toggleMenuReaction(A,'dad',m3,'like',{date:'2026-11-02',at:400});
 toggleMenuReaction(B,'mum',m2,'like',{date:'2026-11-02',at:250});toggleMenuReaction(B,'dad',m3,'dislike',{date:'2026-11-02',at:300});toggleMenuReaction(B,'dad',m1,'like',{date:'2026-11-03',at:500});
 const ab=mergeMenuReactions(A.menuReactions,B.menuReactions),ba=mergeMenuReactions(B.menuReactions,A.menuReactions);
 if(JSON.stringify(ab)!==JSON.stringify(Object.fromEntries(Object.keys(ab).map(k=>[k,ba[k]]))))throw Error('commutative');
 if(!sameMenuReactions(mergeMenuReactions(ab,ab),ab)||!sameMenuReactions(mergeMenuReactions(ab,A.menuReactions),ab))throw Error('idempotent');
 if(ab['little|m2'].v!=='dislike'||ab['mum|m2'].v!=='like')throw Error('both devices kept');if(ab['dad|m3'].v!=='like')throw Error('newest wins');
 if(ab['dad|m3'].h.map(x=>x.v).join()!=='dislike,like')throw Error('history union '+JSON.stringify(ab['dad|m3'].h));
 if(ab['dad|m1'].v!=='none')throw Error('a later clear (tombstone) wins');
 const C=JSON.parse(JSON.stringify(A));C.menuReactions['bad|key']={m:'x'};C.menuReactions['dad|m9']={m:'dad',r:'m9',v:'meh',why:[],at:1,d:'2026-11-01',h:[]};
 if(!validImport(C))throw Error('junk rows never block a family state');if(C.menuReactions['bad|key']||C.menuReactions['dad|m9'])throw Error('junk rows dropped');
 if(mergeMenuReactions(undefined,{"x|y":{}})&&Object.keys(mergeMenuReactions(undefined,{"x|y":{}})).length)throw Error('invalid merge input ignored')})()`));
test('scores are recency weighted; dislikes by eaters sink, likes rise',()=>run(`(()=>{const s=mk(),[m1,m2,m3]=s.recipes;
 toggleMenuReaction(s,'dad',m2,'like',{date:'2026-11-01'});toggleMenuReaction(s,'dad',m3,'like',{date:'2026-05-01'});toggleMenuReaction(s,'little',m1,'dislike',{date:'2026-11-01'});
 const d='2026-11-02',score=r=>reactionRecipeAdjustment(s,r,{date:d});
 if(!(score(m2)>score(m3)&&score(m3)>0))throw Error('recent like outweighs an old like '+score(m2)+' '+score(m3));
 if(!(score(m1)<-15))throw Error('dislike sinks '+score(m1));
 {const away=menuReactionInsight(s,m1,{date:d,eaters:['dad','mum']});if(away.dislikes.length||away.score<0)throw Error('absent member does not count '+JSON.stringify(away))}
 const t=menuTasteModel(s,d);if(!(t.recipes.m2.score>t.recipes.m3.score)||t.recipes.m1.dislikes[0]!=='little')throw Error('model');
 if(menuTasteModel(s,d)!==t)throw Error('memoised');})()`));
test('affinity: spicy aversion and protein liking; explanations',()=>run(`(()=>{const s=mk(),[m1,m2,m3,m4,m5]=s.recipes;globalThis.tr=(vi,en)=>vi;
 toggleMenuReaction(s,'little',m1,'dislike',{date:'2026-11-01'});setMenuReactionReasons(s,'little',m1,['spicy']);
 toggleMenuReaction(s,'little',m4,'dislike',{date:'2026-11-01'});setMenuReactionReasons(s,'little',m4,['spicy']);
 if(!mrRecipeSpicy(m4)||!mrRecipeSpicy(m1)||mrRecipeSpicy(m5))throw Error('spicy detection');
 const d='2026-11-02',x=menuReactionInsight(s,m5,{date:d});if(!x.spicySafe.includes('little'))throw Error('non-spicy dish is safe');
 const why=menuReactionReason(s,m5,{date:d});if(why!=='Bé nhỏ không thích cay — món này không cay')throw Error('reason '+why);
 const pats=familyTasteSummary(s,d).members.find(m=>m.member.id==='little').patterns;if(!pats.some(p=>p.feature==='spicy'&&p.score<0))throw Error('spicy pattern '+JSON.stringify(pats));
 const s2=mk();toggleMenuReaction(s2,'dad',s2.recipes[0],'like',{date:'2026-11-01'});toggleMenuReaction(s2,'mum',s2.recipes[0],'like',{date:'2026-11-01'});toggleMenuReaction(s2,'dad',s2.recipes[4],'like',{date:'2026-11-01'});
 const sim=menuReactionInsight(s2,s2.recipes[4],{date:d,eaters:['mum']});if(sim.similar!=='protein:chicken'||!(sim.score>0))throw Error('similar chicken dish boosted '+JSON.stringify(sim));
 if(menuReactionReason(s2,s2.recipes[4],{date:d,eaters:['mum']})!=='Giống món nhà mình thích (gà)')throw Error('similar reason');
 for(const id of ['dad','mum','big','little'])toggleMenuReaction(s2,id,s2.recipes[2],'like',{date:'2026-10-01'});
 if(menuReactionReason(s2,s2.recipes[2],{date:d})!=='Cả nhà thích · lâu rồi chưa ăn')throw Error('everyone likes, long gap: '+menuReactionReason(s2,s2.recipes[2],{date:d}));
 globalThis.tr=(vi,en)=>en;if(menuReactionReason(s2,s2.recipes[2],{date:d})!=='Everyone likes it · not had for a while')throw Error('EN reason');delete globalThis.tr})()`));
test('fatigue: a favourite eaten often recently is rested',()=>run(`(()=>{const s=mk(),m3=s.recipes[2];globalThis.tr=(vi,en)=>vi;for(const id of ['dad','mum'])toggleMenuReaction(s,id,m3,'like',{date:'2026-10-20'});
 const before=reactionRecipeAdjustment(s,m3,{date:'2026-11-02'});const w=ensureWeek(s,'2026-10-26');w.days['2026-10-27'].dinner.recipes=[clone(m3)];w.days['2026-10-29'].dinner.recipes=[clone(m3)];
 const x=menuReactionInsight(s,m3,{date:'2026-11-02'});if(!x.fatigue||!(x.score<before))throw Error('fatigue '+JSON.stringify(x)+' '+before);
 if(!/nên cho nghỉ/.test(menuReactionReason(s,m3,{date:'2026-11-02'})))throw Error('fatigue reason');
 const s2=mk();toggleMenuReaction(s2,'dad',s2.recipes[2],'like',{date:'2026-10-20'});toggleMenuReaction(s2,'mum',s2.recipes[2],'dislike',{date:'2026-10-30'});setMenuReactionReasons(s2,'mum',s2.recipes[2],['often']);
 if(!menuReactionInsight(s2,s2.recipes[2],{date:'2026-11-02',eaters:['dad']}).fatigue)throw Error('"had it too often" rests it');delete globalThis.tr})()`));
test('auto-plan follows the people eating each meal',()=>run(`(()=>{const s=mk();s.recipes=s.recipes.slice(0,3);const start='2026-11-02',w=ensureWeek(s,start);w.days['2026-11-05'].dinner.attendance.little='away';
 const plain=JSON.parse(JSON.stringify(s));familyGenerate(plain,start,{random:()=>.5});const plainMains=[0,1,2,3].map(i=>plain.weeks[start].days[addDays(start,i)].dinner.recipes.find(r=>r.category==='main').id);
 if(!plainMains.includes('m1'))throw Error('baseline uses m1');
 toggleMenuReaction(s,'little',s.recipes[0],'dislike',{date:'2026-11-01'});familyGenerate(s,start,{random:()=>.5});
 const mains=[0,1,2,3].map(i=>w.days[addDays(start,i)].dinner.recipes.find(r=>r.category==='main').id);
 if(mains.slice(0,3).includes('m1'))throw Error('disliked dish avoided while she eats '+mains);if(mains[3]!=='m1')throw Error('allowed when she is away '+mains);
 const s2=mk();s2.recipes=s2.recipes.slice(0,3);for(const id of ['dad','mum','big','little'])toggleMenuReaction(s2,id,s2.recipes[2],'like',{date:'2026-11-01'});familyGenerate(s2,start,{random:()=>.5});
 if(s2.weeks[start].days[start].dinner.recipes.find(r=>r.category==='main').id!=='m3')throw Error('family favourite first');
 if(JSON.stringify(s2.recipes.map(r=>r.ingredients))!==JSON.stringify(mk().recipes.slice(0,3).map(r=>r.ingredients)))throw Error('recipes untouched; no invented quantities')})()`));
test('suggestions rank liked dishes and keep base filters',()=>run(`(()=>{const s=mk();s.preferences.familyPlanner=true;for(const id of ['dad','mum'])toggleMenuReaction(s,id,s.recipes[4],'like',{date:'2026-11-01'});toggleMenuReaction(s,'dad',s.recipes[0],'dislike',{date:'2026-11-01'});
 const list=recipeSuggestions(s,{date:'2026-11-02',limit:5}).map(x=>x.recipe.id);if(list[0]!=='m5')throw Error('liked first '+list);if(list.indexOf('m1')!==list.length-1)throw Error('disliked last '+list);
 s.recipeFeedback={m5:{rating:'skip',repeatDays:14}};if(recipeSuggestions(s,{date:'2026-11-02',limit:5}).some(x=>x.recipe.id==='m5'))throw Error('pause still wins')})()`));
test('weekly summary and empty model',()=>run(`(()=>{const s=mk();if(familyTasteSummary(s,'2026-11-02').count!==0)throw Error('empty');if(reactionRecipeAdjustment(s,s.recipes[0])!==0)throw Error('no reactions → no change');
 for(const id of ['dad','mum'])toggleMenuReaction(s,id,s.recipes[1],'like',{date:'2026-11-01'});toggleMenuReaction(s,'big',s.recipes[0],'dislike',{date:'2026-10-01'});
 const x=familyTasteSummary(s,'2026-11-02');if(x.week.likes!==2||x.week.dislikes!==0||x.week.top.id!=='m2'||x.week.people!==2)throw Error('week '+JSON.stringify(x.week));
 if(x.loved[0].id!=='m2'||x.avoid[0].id!=='m1'||x.longGap[0]?.id!=='m2')throw Error('lists');})()`));
console.log(`Menu reactions tests passed (${passed}).`);
