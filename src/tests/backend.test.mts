assert.equal((await (await handler(req('state','GET',null,cookie))).json()).state,null);
const state={version:1,members:[{id:'m'}],recipes:[],weeks:{},pantry:[],preferences:{},receipts:[]};
let response=await handler(req('state','PUT',{state,etag:null},cookie));assert.equal(response.status,200);const firstETag=(await response.json()).etag;
assert.equal((await handler(req('state','PUT',{state,etag:null},cookie))).status,409);
response=await handler(req('state','PUT',{state:{...state,marker:'new'},etag:firstETag},cookie));assert.equal(response.status,200);
assert.equal((await handler(req('state','PUT',{state,etag:firstETag},cookie))).status,409);
assert.equal(stored.marker,'new');
const foreign=new Request('https://test.example/.netlify/functions/family?op=state',{method:'PUT',headers:{Origin:'https://other.example',Cookie:cookie},body:'{}'});assert.equal((await handler(foreign)).status,403);
const badState=await handler(req('state','PUT',{state:{version:999},etag},cookie));assert.equal(badState.status,400);
const photoBad=new Request('https://test.example/.netlify/functions/family?op=photo&id=receipt-one',{method:'PUT',headers:{Origin:'https://test.example',Cookie:cookie,'Content-Type':'image/jpeg'},body:'not a jpeg'});assert.equal((await handler(photoBad)).status,400);
