const fixture=await accountFixture(),{getStoreFn,store,cookie,cookieHeader}=fixture;
const handler=createFamilyHandler({getStoreFn});
const req=(op,method='GET',body,cookie)=>new Request('https://test.example/.netlify/functions/family?op='+op,{method,headers:{Origin:'https://test.example',...(cookie?{Cookie:cookie}:{}),...(body?{'Content-Type':'application/json'}:{})},...(body?{body:JSON.stringify(body)}:{})});
assert.equal((await handler(req('state'))).status,401);
assert.equal((await handler(req('login','POST',{password:'retired'}))).status,410);
assert.match(cookieHeader,/HttpOnly/);assert.match(cookieHeader,/Secure/);assert.match(cookieHeader,/SameSite=Strict/);
assert.equal((await (await handler(req('state','GET',null,cookie))).json()).state,null);
const state={version:1,members:[{id:'m'}],recipes:[],weeks:{},pantry:[],preferences:{},receipts:[]};
