// Voice understanding: long, rambling Vietnamese/English speech (incl. elderly-style pauses, repeats and self-corrections).
const fs=require('fs'),vm=require('vm'),assert=require('node:assert/strict');
const c=vm.createContext({console,Intl,Date,Math,URL,structuredClone,crypto:require('node:crypto').webcrypto});
for(const f of ['seed.js','recipe-catalog.js','core.js','spending-core.js','purchase-units.js','planning-core.js','insights-core.js','family-menu-core.js','availability-core.js','personal-core.js'])vm.runInContext(fs.readFileSync('dist/'+f,'utf8'),c);
vm.runInContext(`globalThis.S=defaults();S.preferences.familyPlanner=true;S.weeks={};S.pantry=[];S.recipes.push({...recipe('own-soup','Canh chua cá','soup','fish',20,{fish:400},'prep',['cook']),custom:true,purposes:['side'],yield:4});`,c);
const BASE='2026-11-02',TODAY='2026-11-02';
function parse(text,base=BASE,today=TODAY){c.__t=text;c.__b=base;c.__d=today;return JSON.parse(JSON.stringify(vm.runInContext('parseVoiceInput(__t,S,__b,__d)',c)))}
const run=src=>vm.runInContext(src,c);
// Compact view: [label, qty, unit, ingredient]
const rows=r=>(r.items||[]).map(i=>[i.label,i.qty,i.unit,i.ingredient]);
function expectItems(text,expected,extra){const r=parse(text);try{assert.equal(r.kind,'shopping');assert.deepEqual(rows(r),expected);extra&&extra(r)}catch(e){e.message=`${text}\n${e.message}\nGot: ${JSON.stringify(r)}`;throw e}return r}
let count=0;const t=(name,fn)=>{fn();count++};

const before=JSON.stringify(run('S'));

// ---- Utterances from the investigation ----
t('long VI ramble with fillers, pronouns and a dish for tonight',()=>expectItems('ờ thì mai con mua cho mẹ hai ký thịt ba chỉ với lại một bó rau muống nha, à với ba hộp trứng, còn tối nay nấu canh chua cá lóc',[['thịt ba chỉ',2,'kg','pork'],['rau muống',1,'bó','waterSpinach'],['trứng',3,'hộp','egg']],r=>{assert.equal(r.mealDraft.date,TODAY,'"tối nay" is today, "mai" must not leak from the shopping clause');assert.equal(r.mealDraft.type,'dinner');assert.equal(r.mealDraft.dish,'canh chua cá lóc');assert.ok(r.mealDraft.candidates.includes('own-soup'));assert.ok(r.items.every(i=>!i.needsReview))}));
t('nửa ký, gam, trái; bơ is not beef',()=>expectItems('mua nửa ký tôm, 500 gam sườn non, hai trái bơ',[['tôm',.5,'kg','shrimp'],['sườn non',500,'g','ribs'],['bơ',2,'quả','']]));
t('rưỡi, chục, hai mươi lăm; tôm is not a stray dish',()=>expectItems('hai ký rưỡi thịt bò, một chục trứng, hai mươi lăm con tôm',[['thịt bò',2.5,'kg','beef'],['trứng',10,'quả','egg'],['tôm',25,'con','shrimp']],r=>assert.equal(r.mealDraft,undefined)));
t('con is a unit, nhé is a filler',()=>expectItems('ba bó rau cải nhé với hai con cá lóc',[['rau cải',3,'bó','spinach'],['cá lóc',2,'con','fish']]));
t('two animals by con',()=>expectItems('hai con gà với ba con cá',[['gà',2,'con','chicken'],['cá',3,'con','fish']]));
t('N ký M',()=>expectItems('1 ký 2 thịt heo',[['thịt heo',1.2,'kg','pork']]));
t('mười lăm',()=>expectItems('mười lăm quả trứng',[['trứng',15,'quả','egg']]));
t('hai lạng rưỡi = 250 g',()=>expectItems('hai lạng rưỡi thịt bò',[['thịt bò',250,'g','beef']]));
t('EN kilos/bunch + tonight dish',()=>expectItems('buy two kilos of pork belly and a bunch of bok choy and tonight cook sour fish soup',[['pork belly',2,'kg','pork'],['bok choy',1,'bó','bokchoy']],r=>{assert.equal(r.mealDraft.date,TODAY);assert.equal(r.mealDraft.type,'dinner');assert.ok(r.mealDraft.candidates.includes('own-soup'))}));
t('EN fillers, "can you" is not a unit, count without unit',()=>expectItems('um can you get like half a kilo of prawns and uh also two avocados please',[['prawns',.5,'kg','shrimp'],['avocados',2,'quả','']]));

// ---- More numbers & units ----
t('hai mươi mốt / ba mươi tư / một trăm linh năm',()=>{expectItems('hai mươi mốt quả trứng, ba mươi tư con tôm, một trăm linh năm gam tiêu',[['trứng',21,'quả','egg'],['tôm',34,'con','shrimp'],['tiêu',105,'g','pepper']])});
t('nửa lạng, ki lô, cân next to a number only, digits glued to units',()=>expectItems('nửa lạng tỏi, hai ki lô khoai tây, 3 cân gạo, 2kg cà rốt, 1,5 lít sữa',[['tỏi',50,'g','garlic'],['khoai tây',2,'kg','potato'],['gạo',3,'kg','rice'],['cà rốt',2,'kg','carrot'],['sữa',1.5,'l','']]));
t('lon/can only after a number; dozen; couple; point',()=>expectItems('a can of coconut water, a dozen eggs, a couple of limes and one point five litres of stock',[['coconut water',1,'lon','coconut'],['eggs',12,'quả','egg'],['limes',2,'quả','lime'],['stock',1.5,'l','broth']]));
t('một tá, hai chục quả',()=>expectItems('một tá trứng và hai chục quả chanh',[['trứng',12,'quả','egg'],['chanh',20,'quả','lime']]));
t('gói, khay, chai, túi, vỉ, củ, nắm, hộp',()=>expectItems('2 gói bún, 1 khay thịt gà, 1 chai dầu ăn, 1 túi gạo, 1 vỉ trứng, 3 củ hành tây, 1 nắm rau thơm, 2 hộp đậu hũ',[['bún',2,'gói','noodle'],['thịt gà',1,'khay','chicken'],['dầu ăn',1,'chai','oil'],['gạo',1,'túi','rice'],['trứng',1,'vỉ','egg'],['hành tây',3,'củ','onion'],['rau thơm',1,'nắm','herbs'],['đậu hũ',2,'hộp','tofu']]));
t('quantity after the name',()=>expectItems('thịt bò 500g, cà chua 1 ký, trứng 10 quả',[['thịt bò',500,'g','beef'],['cà chua',1,'kg','tomato'],['trứng',10,'quả','egg']]));
t('no separators between items',()=>expectItems('hai ký thịt heo một bó rau muống ba quả chanh',[['thịt heo',2,'kg','pork'],['rau muống',1,'bó','waterSpinach'],['chanh',3,'quả','lime']]));
t('hai ký ba chỉ (pork belly) is not 2.3 kg',()=>expectItems('hai ký ba chỉ',[['ba chỉ',2,'kg','pork']]));
t('bó ≠ bò ≠ bơ',()=>expectItems('một bó hành, một ký bò, một ký bơ',[['hành',1,'bó','scallion'],['bò',1,'kg','beef'],['bơ',1,'kg','']]));

// ---- Never invent ----
t('unknown amounts stay unknown and flagged',()=>expectItems('mấy ký thịt heo, ờ, chưa biết, với lại vài bó rau',[['thịt heo',null,'kg','pork'],['rau',null,'bó','spinach']],r=>assert.ok(r.items.every(i=>i.needsReview))));
t('no quantity at all',()=>expectItems('thêm sữa, giấy ăn',[['sữa',null,'',''],['giấy ăn',null,'','']],r=>assert.ok(r.items.every(i=>i.needsReview))));
t('unknown measure word is not turned into a count',()=>{const r=parse('2 muỗng nước mắm');assert.equal(r.items.length,1);assert.equal(r.items[0].qty,null);assert.ok(r.items[0].needsReview)});
t('range keeps upper bound but flags it',()=>expectItems('hai ba ký cá basa',[['cá basa',3,'kg','fish']],r=>assert.ok(r.items[0].needsReview)));

// ---- Ten+ realistic long elderly-style utterances ----
t('elderly 1: vocative, giùm mẹ, pauses with …',()=>expectItems('à mẹ ơi, mai con đi chợ thì mua giùm mẹ ba lạng thịt bò, ờ, hai bó hành lá, rồi thì... một chai nước mắm nha con',[['thịt bò',300,'g','beef'],['hành lá',2,'bó','scallion'],['nước mắm',1,'chai','fishSauce']]));
t('elderly 2: self-correction "à nhầm" + repeated item gets the amount said later',()=>expectItems('ừ thì ba ký à nhầm hai ký sườn non, với lại trứng, trứng thì mua hai chục',[['sườn non',2,'kg','ribs'],['trứng',20,'quả','egg']]));
t('elderly 3: weekday dish for six + shopping',()=>expectItems('thứ bảy này nấu bún bò huế cho sáu người, nhớ mua hai ký bắp bò với một ký bún',[['bắp bò',2,'kg','beef'],['bún',1,'kg','noodle']],r=>{assert.equal(r.mealDraft.date,'2026-11-07');assert.equal(r.mealDraft.servings,6);assert.equal(r.mealDraft.dish,'bún bò huế')}));
t('elderly 4: amount and item split by a long pause',()=>expectItems('con ơi, à, cái, mua cho bà một ký cà chua, một ký... ờ... khoai tây, với lại nửa ký tỏi',[['cà chua',1,'kg','tomato'],['khoai tây',1,'kg','potato'],['tỏi',.5,'kg','garlic']]));
t('elderly 5: stutters and repeats collapse to one line',()=>expectItems('hai hai ký thịt heo nha, hai ký thịt heo, thịt heo đó',[['thịt heo',2,'kg','pork']]));
t('elderly 6: "à không" correction of the amount only',()=>expectItems('mua hai ký thịt bò à không ba ký',[['thịt bò',3,'kg','beef']]));
t('elderly 7: cancel an item',()=>expectItems('mua rau muống, à thôi khỏi, mua hai bó cải thìa',[['cải thìa',2,'bó','bokchoy']]));
t('elderly 8: dictated list with colon and full stop, dish tomorrow',()=>expectItems('Mẹ dặn: mua hai hộp đậu hũ, một vỉ trứng, với hai trái chanh. Còn tối mai nấu thịt kho trứng cho cả nhà',[['đậu hũ',2,'hộp','tofu'],['trứng',1,'vỉ','egg'],['chanh',2,'quả','lime']],r=>{assert.equal(r.mealDraft.date,'2026-11-03');assert.equal(r.mealDraft.type,'dinner');assert.ok(r.mealDraft.candidates.length)}));
t('elderly 9 (EN): correction "no wait"',()=>expectItems('okay so uh we need a dozen eggs, a couple of lemons, no wait, three lemons, and a bag of rice',[['eggs',12,'quả','egg'],['lemons',3,'quả','lime'],['rice',1,'túi','rice']]));
t('elderly 10 (EN): "actually make that three" keeps the unit',()=>expectItems('two kilos of chicken thighs, actually make that three, and one point five litres of milk',[['chicken thighs',3,'kg','chicken'],['milk',1.5,'l','']]));
t('elderly 11 (EN): thinking aloud + tomorrow dish',()=>expectItems("Now, um, let me think. Tomorrow we're having pho, so get me a kilo of beef, ah, two packets of pho noodles, and a bunch of, what's it called, Thai basil",[['beef',1,'kg','beef'],['pho noodles',2,'gói','riceNoodle'],['thai basil',1,'bó','herbs']],r=>{assert.equal(r.mealDraft.date,'2026-11-03');assert.ok(r.mealDraft.candidates.some(id=>id==='n1'||id==='n2'))}));
t('elderly 12: meal-only with change of mind',()=>{const r=parse('ờ… hôm nay… à… ăn phở bò, mà thôi, ăn bún bò đi');assert.equal(r.kind,'meal');assert.equal(r.dish,'bún bò');assert.equal(r.date,TODAY)});
t('elderly 13: dish list joined by với keeps tonight',()=>{const r=parse('tối nay ăn canh chua cá với cá kho tộ');assert.equal(r.kind,'meal');assert.equal(r.mealDrafts.length,2);assert.ok(r.mealDrafts.every(m=>m.date===TODAY&&m.type==='dinner'));assert.equal(r.candidates[0],'own-soup')});
t('elderly 14: trailing servings after a comma',()=>{const r=parse('tối mai nấu canh chua cá, cho bốn người nhé');assert.equal(r.kind,'meal');assert.equal(r.servings,4);assert.equal(r.date,'2026-11-03')});
t('elderly 15: ba ơi is a call, not 3',()=>expectItems('ba ơi mua hai ký gà',[['gà',2,'kg','chicken']]));

// ---- Dates: "nay" = today even when another day is open in the planner; weekdays never go into the past ----
t('today vs selected day',()=>{const r=parse('tối nay nấu canh chua cá','2026-11-09','2026-11-02');assert.equal(r.date,'2026-11-02');const m=parse('trưa mai ăn phở','2026-11-09','2026-11-02');assert.equal(m.date,'2026-11-03');assert.equal(m.type,'lunch');const plain=parse('nấu canh chua cá','2026-11-09','2026-11-02');assert.equal(plain.date,'2026-11-09','no time word keeps the selected day');const wd=parse('thứ hai nấu canh chua cá','2026-11-04','2026-11-04');assert.equal(wd.date,'2026-11-09')});
t('unaccented typing still works',()=>expectItems('mua 2 ky thit heo, 1 bo rau muong',[['thit heo',2,'kg','pork'],['rau muong',1,'bó','waterSpinach']]));

// ---- Recognition helpers ----
t('alternative picker scores Vietnamese words with Unicode boundaries',()=>{c.__alts=[{transcript:'hai kì thít ba trì',confidence:.9},{transcript:'hai ký thịt ba chỉ',confidence:.6}];assert.equal(run('pickBestVoiceAlt(__alts)'),'hai ký thịt ba chỉ');assert.ok(run("voiceAltScore('ăn phở',1)")>run("voiceAltScore('an pho',1)"));assert.ok(run("voiceAltScore('một bó rau',1)")>=3)});
t('Android duplicate finals are merged',()=>{assert.deepEqual(JSON.parse(run(`JSON.stringify(['hai ký thịt','hai ký thịt bò','hai ký thịt bò','một bó rau'].reduce((l,x)=>mergeVoiceFinal(l,x),[]))`)),['hai ký thịt bò','một bó rau'])});
// ---- Bilingual results (owner report: English selected but results came out Vietnamese) ----
// language.js data (English ingredient and recipe names) loads after personal-core in the app; load the same data here.
{const lang=fs.readFileSync('dist/language.js','utf8');vm.runInContext('var familyStorage={getItem(){return null},setItem(){}};'+lang.slice(0,lang.indexOf('function applyLanguage(')),c)}
const view=(i:any,l:string)=>{c.__i=i;c.__l=l;const v=JSON.parse(run('JSON.stringify(voiceItemView(__i,__l))'));return[v.name,v.unit]};
const views=(text:string,l:string)=>parse(text).items.map((i:any)=>view(i,l));
const ids=(text:string)=>parse(text).items.map((i:any)=>i.ingredient);
t('EN UI + en-AU speech → English names and units',()=>{assert.deepEqual(views('two kilos of pork belly and a bunch of water spinach','en'),[['Pork belly','kg'],['Water spinach','bunch']]);assert.deepEqual(views('three cloves of garlic and two bottles of fish sauce','en'),[['Garlic','cloves'],['Fish sauce','bottles']])});
t('VI UI + vi-VN speech → Vietnamese names and units',()=>{assert.deepEqual(views('hai ký thịt ba chỉ và một bó rau muống','vi'),[['Thịt ba chỉ','kg'],['Rau muống','bó']]);assert.deepEqual(views('ba tép tỏi, hai chai nước mắm','vi'),[['Tỏi','tép'],['Nước mắm','chai']])});
t('mixed-language speech understood in both UI languages',()=>{const text='2 kg pork belly với một bó rau muống';assert.deepEqual(ids(text),['pork','waterSpinach']);assert.deepEqual(views(text,'en'),[['Pork belly','kg'],['Water spinach','bunch']]);assert.deepEqual(views(text,'vi'),[['Thịt ba chỉ','kg'],['Rau muống','bó']]);
 assert.deepEqual(views('mua 3 hộp eggs','en'),[['Eggs','boxes']]);assert.deepEqual(views('mua 3 hộp eggs','vi'),[['Trứng','hộp']]);
 const sp=parse('spaghetti tối nay');assert.equal(sp.kind,'meal');assert.equal(sp.date,TODAY);assert.equal(sp.type,'dinner');assert.ok(sp.candidates.length,'spaghetti matches library recipes');
 const bo=parse('on monday cook spaghetti bolognese');c.__r=bo.candidates[0];assert.match(run("voiceRecipeTitle(S.recipes.find(r=>r.id===__r),'en')"),/Spaghetti Bolognese/);assert.match(run("voiceRecipeTitle(S.recipes.find(r=>r.id===__r),'vi')"),/Mì Ý Bolognese/)});
t('same utterance in either language → same ingredient ids',()=>{for(const[en,vi]of[['two kilos of pork belly and a bunch of water spinach','hai ký thịt ba chỉ và một bó rau muống'],['a dozen eggs and half a kilo of prawns','một tá trứng và nửa ký tôm'],['a bunch of coriander, a bunch of vietnamese mint, two stalks of lemongrass','một bó ngò rí, một bó rau răm, hai cây sả'],['one kilo of beef mince and a pack of tofu','một ký thịt bò xay và một gói đậu hũ'],['two heads of bok choy and a bag of jasmine rice','hai bắp cải thìa và một túi gạo thơm']])assert.deepEqual(ids(en),ids(vi),en+' / '+vi);
 // The parser does not depend on the UI language at all; only the view does.
 run("appLanguage='en'");const a=JSON.stringify(rows(parse('2 kg pork belly với một bó rau muống')));run("appLanguage='vi'");assert.equal(JSON.stringify(rows(parse('2 kg pork belly với một bó rau muống'))),a)});
t('coriander and Vietnamese mint stay two lines (same catalog id, different herbs)',()=>{const r=parse('a bunch of cilantro, a bunch of vietnamese mint');assert.equal(r.items.length,2);assert.deepEqual(r.items.map((i:any)=>view(i,'vi')[0]),['Ngò rí','Rau răm'])});
t('English numbers',()=>{for(const[text,qty,unit]of[['one kilo of beef',1,'kg'],['eleven eggs',11,'quả'],['nineteen eggs',19,'quả'],['twenty one eggs',21,'quả'],['ninety nine grams of pepper',99,'g'],['one hundred and fifty grams of ginger',150,'g'],['a hundred grams of ginger',100,'g'],['half a kilo of beef',.5,'kg'],['a quarter kilo of tofu',.25,'kg'],['three quarters of a kilo of beef',.75,'kg'],['a kilo of beef',1,'kg'],['an onion',1,'củ'],['a couple of onions',2,'củ'],['a dozen eggs',12,'quả'],['half a dozen eggs',6,'quả'],['two dozen eggs',24,'quả'],['one and a half kilos of beef',1.5,'kg'],['two point five kg of chicken',2.5,'kg'],['2.5 kg of chicken',2.5,'kg']]as const){const r=parse(text);assert.equal(r.items.length,1,text);assert.equal(r.items[0].qty,qty,text);assert.equal(r.items[0].unit,unit,text)}});
t('English fillers, corrections and time words',()=>{expectItems('um, uh, like, you know, could you please grab me two kilos of prawns, maybe',[['prawns',2,'kg','shrimp']]);expectItems('get me twenty two eggs, no wait, twenty four',[['eggs',24,'quả','egg']]);expectItems('two kilos of pork, actually make that 2.5',[['pork',2.5,'kg','pork']]);expectItems('I need a bag of rice and then also a bunch of bok choy',[['rice',1,'túi','rice'],['bok choy',1,'bó','bokchoy']]);
 for(const[text,date,type]of[['tonight cook beef pho',TODAY,'dinner'],['tomorrow for lunch cook beef pho','2026-11-03','lunch'],['this weekend cook beef pho','2026-11-07','dinner'],['on friday cook beef pho','2026-11-06','dinner'],['for breakfast tomorrow cook beef pho','2026-11-03','breakfast']]as const){const r=parse(text);assert.equal(r.kind,'meal',text);assert.equal(r.date,date,text);assert.equal(r.type,type,text)}});
t('container and count units in both languages (only after a number)',()=>{for(const[vi,en,unit]of[['hai chai nước mắm','two bottles of fish sauce','chai'],['một lọ tương ớt','one jar of chilli sauce','lọ'],['một hũ sữa chua','one tub of yogurt','hũ'],['hai lon nước dừa','two cans of coconut water','lon'],['một thùng nước suối','one case of water','thùng'],['một két bia','one crate of beer','két'],['một bao gạo','one sack of rice','bao'],['một bình nước','one jug of water','bình'],['một tuýp kem đánh răng','one tube of toothpaste','tuýp'],['hai viên súp','two tablets of stock','viên'],['ba cuộn giấy','three rolls of paper towel','cuộn'],['một vỉ trứng','one card of eggs','vỉ'],['một khay thịt gà','one tray of chicken','khay'],['một túi gạo','one bag of rice','túi'],['hai gói bún','two packets of vermicelli','gói'],['một hộp đậu hũ','one box of tofu','hộp'],['một bó rau muống','one bunch of water spinach','bó'],['một nắm rau thơm','one handful of herbs','nắm'],['hai cây sả','two stalks of lemongrass','cây'],['ba củ hành tây','three bulbs of onion','củ'],['ba tép tỏi','three cloves of garlic','tép'],['một nhánh gừng','one knob of ginger','nhánh'],['một bắp xà lách','one head of lettuce','bắp'],['hai bắp ngô','two cobs of corn','bắp']]as const){for(const text of[vi,en]){const r=parse(text);assert.equal(r.items.length,1,text);assert.equal(r.items[0].unit,unit,text);assert.ok(r.items[0].qty>0,text)}}
 expectItems('one jerrycan of water',[['water',1,'can','']]);expectItems('hai lạng thịt bò, một chục trứng, một tá chanh',[['thịt bò',200,'g','beef'],['trứng',10,'quả','egg'],['chanh',12,'quả','lime']])});
t('pounds/ounces are kept, never converted, and flagged; a handful is flagged approximate',()=>{const lb=parse('2 pounds of beef').items[0];assert.equal(lb.qty,2);assert.equal(lb.unit,'lb');assert.ok(lb.needsReview);assert.equal(lb.unitNote,'no-convert');const oz=parse('eight ounces of ginger').items[0];assert.equal(oz.unit,'oz');assert.equal(oz.qty,8);assert.ok(oz.needsReview);const h=parse('một nắm rau thơm').items[0];assert.equal(h.unit,'nắm');assert.ok(h.needsReview);assert.equal(h.unitNote,'approx')});
t('unknown items keep exactly what was said in both UI languages',()=>{const r=parse('two packets of bean sprouts, one hundred grams of chilli and two cans of coconut milk');assert.deepEqual(rows(r),[['bean sprouts',2,'gói',''],['chilli',100,'g',''],['coconut milk',2,'lon','']],'no false match to green beans / coconut water');for(const l of['vi','en'])assert.deepEqual(r.items.map((i:any)=>view(i,l)[0]),['bean sprouts','chilli','coconut milk']);assert.equal(view(parse('một ký giấy bạc').items[0],'en')[0],'giấy bạc')});
t('no invented quantities in English',()=>{const r=parse('some bok choy, a few limes and a little ginger');assert.ok(r.items.length>=2);assert.ok(r.items.every((i:any)=>i.qty===null&&i.needsReview),JSON.stringify(rows(r)))});
t('heard words are shown when the UI-language name differs',()=>{c.__i=parse('a bunch of cilantro').items[0];assert.equal(run("voiceItemView(__i,'vi').heard"),'cilantro');assert.equal(run("voiceItemView(__i,'en').name"),'Coriander');c.__i=parse('hai ký thịt bò').items[0];assert.equal(run("voiceItemView(__i,'vi').heard"),'')});
t('confirmed lines keep the ingredient id and a canonical name so the list re-renders in either language',()=>{const items=parse('two kilos of pork belly and a bunch of water spinach').items.map((i:any)=>{const[name,unit]=view(i,'en');return{...i,label:name,unit}});c.__items=items;run("globalThis.__w={extras:[]};applyVoiceShopping(S,__w,__items)");const ex=JSON.parse(run('JSON.stringify(__w.extras)'));assert.deepEqual(ex.map((e:any)=>[e.name,e.nameEn,e.qty,e.ingredient]),[['Thịt ba chỉ','Pork belly','2 kg','pork'],['Rau muống','Water spinach','1 bó','waterSpinach']]);
 // A line the family edited is stored exactly as typed.
 c.__items=[{...parse('a bunch of coriander').items[0],label:'Ngò gai',unit:'bunch'}];run("globalThis.__w={extras:[]};applyVoiceShopping(S,__w,__items)");assert.deepEqual(JSON.parse(run('JSON.stringify(__w.extras)')).map((e:any)=>[e.name,e.qty,e.nameEn]),[['Ngò gai','1 bó',undefined]])});
t('low-confidence / wrong-language suggestion heuristic',()=>{const hint=(text:string,lang:string,conf?:number)=>{c.__h=[text,lang,conf];return run('voiceLanguageHint(__h[0],__h[1],__h[2],S)')};
 assert.equal(hint('hai ky thit ba chi voi mot bo rau muong','en-AU',.8)?.lang,'vi-VN','plain Vietnamese words under English recognition');
 assert.equal(hint('hai ký thịt ba chỉ','en-AU',.9)?.lang,'vi-VN','Vietnamese diacritics under English recognition');
 assert.equal(hint('high key tit by tree','en-AU',.31)?.lang,'vi-VN','unsure and nothing recognisable');
 assert.equal(hint('two kilos of pork belly and a bunch of bok choy','vi-VN',.9)?.lang,'en-AU','English under Vietnamese recognition');
 assert.equal(hint('two kilos of pork belly','en-AU',.92),null);assert.equal(hint('hai ký thịt ba chỉ','vi-VN',.4),null,'low confidence but items recognised');
 assert.equal(hint('2 kg pork belly với một bó rau muống','vi-VN',.9),null,'mixed speech that parses is left alone');assert.equal(hint('mua 3 hộp eggs','vi-VN',.9),null);assert.equal(hint('','en-AU',.1),null)});
t('recognition language defaults to the UI language; a manual choice is remembered',()=>{assert.equal(run("voiceDefaultRecLang('en',{auto:true,lang:'vi-VN'})"),'en-AU');assert.equal(run("voiceDefaultRecLang('vi',{auto:true,lang:'en-AU'})"),'vi-VN');assert.equal(run("voiceDefaultRecLang('vi',{auto:false,lang:'en-AU'})"),'en-AU');assert.equal(run("voiceDefaultRecLang('en',{auto:false,lang:''})"),'en-AU')});
t('alternatives are scored with both vocabularies and keep their confidence',()=>{c.__a=[{transcript:'to kill us of pork belly',confidence:.5},{transcript:'two kilos of pork belly',confidence:.4}];assert.deepEqual(JSON.parse(run('JSON.stringify(pickBestVoiceAltInfo(__a))')),{text:'two kilos of pork belly',confidence:.4});c.__a=[{transcript:'hai ký thịt ba chỉ',confidence:.7},{transcript:'hai kì thít ba chi',confidence:.6}];assert.equal(run('pickBestVoiceAltInfo(__a)').text,'hai ký thịt ba chỉ')});
t('library recipe titles follow the UI language; family recipes stay as written',()=>{assert.equal(run("voiceRecipeTitle(S.recipes.find(r=>r.id==='own-soup'),'en')"),'Canh chua cá');const r=parse('tomorrow cook beef pho');c.__r=r.candidates[0];assert.match(run("voiceRecipeTitle(S.recipes.find(r=>r.id===__r),'en')"),/pho/i);assert.match(run("voiceRecipeTitle(S.recipes.find(r=>r.id===__r),'vi')"),/Phở/)});
t('parsing never mutates state',()=>assert.equal(JSON.stringify(run('S')),before));
console.log(`PASS voice: ${count} checks — VI/EN long speech, fillers, corrections, units, numbers, dates, dedupe, alternative picking, bilingual names/units, language hints`);
