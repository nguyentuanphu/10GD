 const spagId=await page.locator('#meal-lib-list input[name="recipe"]').first().getAttribute('value');await page.locator(`#meal-lib-list input[value="${spagId}"]`).check();
 await page.locator('#meal-dish-search').fill('');await settle(page);await page.locator('#meal-dish-search').click();await imeType(cdp,[['p','ph','phơ','phở']]);await settle(page);
 assert.equal(await page.locator('#meal-dish-search[data-same="1"]').inputValue(),'phở','input kept while typing');
 const own=await ownRows();lib=await libRows();assert.deepEqual(own.map(t=>t.split('\n')[0].trim().replace(/\s*\(.*$/,'')),['Phở bò nhà mình'],'family section filtered to phở');
 assert.ok(await page.locator(`#meal-lib-list input[value="${spagId}"]`).isChecked(),'ticked spaghetti stays ticked and in the form');/* v1.7.10: two Phở dishes remain; every one ranks before any other dish */{const rest=lib.slice(1),cut=rest.findIndex(t=>!/^Phở/.test(t.trim()));assert.ok(cut>=1&&rest.slice(cut).every(t=>!/^Phở/.test(t.trim())),'phở dishes rank first: '+rest.slice(0,4))}
 await page.locator('#meal-dish-search').fill('');await settle(page);await page.locator('#meal-dish-search').click();await imeType(cdp,[['c','ca','can','canh'],['c','ch','chu','chua']]);await settle(page);lib=(await libRows()).slice(1).map(t=>t.trim());const sour=lib.filter(t=>/^Canh chua/i.test(t)).length;assert.ok(sour>=1&&lib.slice(0,sour).every(t=>/^Canh chua/i.test(t))&&lib.every(t=>/canh|chua/i.test(t)),'canh chua dishes rank first: '+lib.slice(0,3));assert.ok(await page.locator(`#meal-lib-list input[value="${spagId}"]`).isChecked());
 await scrollTo(page,'#meal-dish-search');await page.locator('#modal-root .modal').evaluate(el=>{const s=el.querySelector('#meal-dish-search');s.scrollIntoView({block:'start'})});await page.screenshot({path:`${dir}/${name}-meal-search-vi.png`});await noOverflow(page,name+' meal search');
 await page.locator('#meal-dish-search').fill('xyzkhongco');await settle(page);assert.match(await mealStatus(),/Không tìm thấy món ăn khớp.*\(0 món\)/);assert.ok(await page.locator('#meal-lib-list .meal-search-empty').count());assert.ok(await page.locator(`#meal-lib-list input[value="${spagId}"]`).isChecked(),'selection kept on an empty search');
