 // English meal editor.
 await page.evaluate(d=>{changeAppLanguage('en');familyEditMeal(d,'breakfast')},mealDate);await page.locator('#meal-dish-search').waitFor();await page.locator('#meal-dish-search').click();await page.keyboard.type('spag');await settle(page);assert.match(await mealStatus(),/dishes match “spag”/);assert.ok((await libRows()).length>=3);/* v1.7.8: 3 suggestions per section */assert.match(await page.locator('#meal-lib-list [data-meal-more="lib"]').innerText(),/Show 3 more/,'v1.7.8: top 3 + Show more (EN)');await page.locator('#modal-root .modal').evaluate(el=>el.querySelector('#meal-dish-search').scrollIntoView({block:'start'}));await page.screenshot({path:`${dir}/${name}-meal-search-en.png`});await noOverflow(page,name+' meal EN');await page.evaluate(()=>{closeModal();changeAppLanguage('vi')});
