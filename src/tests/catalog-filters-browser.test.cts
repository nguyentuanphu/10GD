// v1.5 owner report: library filter chips (Món nước, Âu/Ý, Healthy, Vegetarian, Thuần chay, Salad hạt, Dressing) in every
// scope, chip + search, keyboard/touch, English labels; meal editor dish search ("spag", "phở", "canh chua" through a real
// IME composition) filtering both sections while keeping ticked dishes. Screenshots at 375×812, 820×1100 and 1280×800.
const {chromium}=require('playwright'),fs=require('fs'),path=require('path'),assert=require('assert');
const root=process.cwd(),dir='docs/reviews/v1.5/catalog';fs.mkdirSync(dir,{recursive:true});
const types={'.html':'text/html','.js':'application/javascript','.json':'application/json','.css':'text/css','.webp':'image/webp','.svg':'image/svg+xml','.png':'image/png','.webmanifest':'application/manifest+json'};
async function route(page){await page.route('https://kitchen.test/**',async r=>{const url=new URL(r.request().url());if(url.pathname.startsWith('/.netlify/')){const op=url.searchParams.get('op');return r.fulfill({json:op==='status'?{configured:false,connected:false}:op==='state'?{state:null,etag:null}:op==='families'?{families:[]}:{announcements:[],devices:[]}})}const file=path.join(root,'dist',url.pathname==='/'?'index.html':url.pathname);try{await r.fulfill({body:fs.readFileSync(file),contentType:types[path.extname(file)]||'application/octet-stream'})}catch{await r.fulfill({status:404,body:'Missing'})}})}
async function imeType(cdp,words){for(const [i,steps] of words.entries()){for(const t of steps)await cdp.send('Input.imeSetComposition',{text:t,selectionStart:t.length,selectionEnd:t.length});await cdp.send('Input.insertText',{text:steps[steps.length-1]});if(i<words.length-1)await cdp.send('Input.insertText',{text:' '})}}
const settle=page=>page.waitForTimeout(260);
const noOverflow=async(page,label)=>assert(await page.evaluate(()=>document.documentElement.scrollWidth<=innerWidth+1),'horizontal overflow: '+label);
const scrollTo=(page,sel)=>page.evaluate(sel=>{const el=document.querySelector(sel);if(el)window.scrollTo(0,el.getBoundingClientRect().top+scrollY-70)},sel);
const cards=page=>page.locator('#family-recipe-results .recipe-card h3').allInnerTexts();
// Expected counts are computed from catalogue fields and ingredient diet labels, independently of the chip code.
const expected=(page,scope,key,kind,q='')=>page.evaluate(([scope,key,kind,q])=>{const inScope=r=>scope==='all'||(scope==='own'?ownRecipe(r):!ownRecipe(r)||!!q);const meta=r=>libraryRecipeMeta(r);const test={western:r=>recipeCuisine(meta(r))==='western',healthy:r=>recipeMatchesLibraryTag(r,'healthy'),vegetarian:r=>['vegan','vegetarian','check'].includes(recipeDiet(r)),vegan:r=>recipeDiet(r)==='vegan','seed-salad':r=>meta(r).recipeKind==='seed-salad',dressing:r=>meta(r).recipeKind==='dressing'};return state.recipes.filter(r=>inScope(r)&&(kind==='cat'?r.category===key:test[key](r))&&(!q||recipeSearchScore(r,q)>0)).length},[scope,key,kind,q]);
// v1.7.10: no Salad hạt chip (those mixes were retired)
const CHIPS=[['cat','noodle'],['tag','western'],['tag','healthy'],['tag','vegetarian'],['tag','vegan'],['tag','dressing']];
// v1.7: diet chips (Healthy, Vegetarian, Thuần chay) live in the Filters sheet as data-fm="diet-filter"; the sheet is opened once per page.
const DIETS=['healthy','vegetarian','vegan'];
const chip=(page,kind,key)=>page.locator(`#family-recipe-chips [data-fm="${kind==='tag'&&DIETS.includes(key)?'diet':kind}-filter"][data-key="${key}"]`);
const statusCount=async page=>+((await page.locator('#family-recipe-status').innerText()).match(/^(\d+)/)||[])[1];
(async()=>{const browser=await chromium.launch(process.env.BEP_CHROMIUM?{executablePath:process.env.BEP_CHROMIUM}:{});const summary={};
for(const [name,width,height] of [['mobile',375,812],['tablet',820,1100],['desktop',1280,800]]){
 const context=await browser.newContext({viewport:{width,height},reducedMotion:'reduce',hasTouch:name!=='desktop',isMobile:name==='mobile'}),page=await context.newPage(),errors=[];page.on('pageerror',e=>errors.push(e.message));await route(page);
 await page.goto('https://kitchen.test/#recipes');await page.locator('#family-recipe-search').waitFor({timeout:20000});
 await page.evaluate(()=>{localStorage.setItem('bep-theme-mode','light');applyThemePreferences();const fam=(id,name,category,ingredients)=>({id,name,category,protein:'mixed',time:20,servings:4,yield:4,ingredients,prep:'',steps:['Nấu.'],favorite:false,custom:true,origin:'family',purposes:['main']});state.recipes.push(fam('fam-tofu','Đậu hũ chiên sả nhà mình','main',[{id:'tofu',qty:300},{id:'lemongrass',qty:20}]),fam('fam-egg','Trứng chiên hành nhà mình','main',[{id:'egg',qty:4},{id:'scallion',qty:20}]),fam('fam-pho','Phở bò nhà mình','noodle',[{id:'beef',qty:300},{id:'noodle',qty:400}]),fam('fam-ribs','Sườn ram nhà mình','main',[{id:'ribs',qty:500}]));save();render()});
 await page.locator('#toast.visible').waitFor({state:'hidden',timeout:10000}).catch(()=>{});
 await page.locator('#family-recipe-chips [data-fm="filter-sheet"]').click();await page.locator('#family-filter-panel').waitFor();
 // 1. Every chip in every scope: status count, chip badge and cards agree with the catalogue; aria-pressed; ≥44px.
 const counts={},shotClip={x:0,y:0,width,height:name==='mobile'?height:name==='tablet'?520:460};
 for(const scope of ['own','samples','all']){await page.locator(`[data-fm="${scope}"]`).first().click();await page.locator('#family-recipe-chips').waitFor();
  for(const [kind,key] of CHIPS){const want=await expected(page,scope,key,kind);const badge=+(await chip(page,kind,key).locator('.chip-count').innerText());assert.equal(badge,want,`${scope} ${key} badge`);
   if(name==='mobile')await chip(page,kind,key).tap();else await chip(page,kind,key).click();
   assert.equal(await chip(page,kind,key).getAttribute('aria-pressed'),'true',`${key} pressed`);assert.equal(await statusCount(page),want,`${scope} ${key} status count`);
   const shown=await cards(page);assert.equal(shown.length,Math.min(20,want),`${scope} ${key} cards`);if(!want)assert.ok(await page.locator('.library-no-match').count(),'no-match state instead of the first-run card');
   if(want>20)assert.match(await page.locator('#family-recipe-results').innerText(),new RegExp(`Đang hiện 20/${want} món`));
   counts[scope+':'+key]=want;
   const box=await chip(page,kind,key).boundingBox();assert.ok(box.height>=44&&box.width>=44,`${key} chip ≥44px (${box.width}×${box.height})`);
   await chip(page,kind,key).click();assert.equal(await chip(page,kind,key).getAttribute('aria-pressed'),'false','second tap clears the chip')}
 }
 assert.equal(counts['samples:dressing'],7);assert.equal(counts['all:dressing'],await page.evaluate(()=>PLANT_RECIPES.filter(r=>r.recipeKind==='dressing').length));
 for(const scope of ['own','samples','all'])assert.ok(counts[scope+':vegetarian']>counts[scope+':vegan'],`${scope}: Vegetarian is strictly larger than Thuần chay`);
 assert.equal(counts['own:vegan'],1);assert.equal(counts['own:vegetarian'],2);assert.equal(counts['own:noodle'],1);
 assert.ok(counts['samples:western']>=45&&counts['samples:healthy']>=20&&counts['samples:noodle']>=19/* v1.7.10: recognised dishes only */);
 summary[name]=counts;
 // Vegetarian and Thuần chay really show different dishes (an egg dish appears only under Vegetarian).
 await page.locator('[data-fm="samples"]').first().click();await chip(page,'tag','vegetarian').click();const vegNames=new Set(await page.evaluate(()=>familyRecipeRows().map(r=>r.name)));await chip(page,'tag','vegan').click();const veganNames=await page.evaluate(()=>familyRecipeRows().map(r=>r.name));assert.ok(veganNames.every(n=>vegNames.has(n))&&vegNames.has('Canh cà chua trứng')&&!veganNames.includes('Canh cà chua trứng'));
 // Spot-check what each chip shows.
 for(const [kind,key,re] of [['cat','noodle',/^(Phở|Bún|Hủ tiếu|Mì|Miến|Udon|Nui|Cháo|Súp|Bánh canh)/],['tag','dressing',/^Dressing/]]){await chip(page,kind,key).click();const shown=await cards(page);assert.ok(shown.length&&shown.every(t=>re.test(t)),`${key} shows ${shown.slice(0,4)}`);await chip(page,kind,key).click()}
 await chip(page,'tag','western').click();assert.ok((await cards(page)).some(t=>/Spaghetti|Mì Ý|Penne/.test(t)),'Âu/Ý shows Italian dishes');await chip(page,'tag','western').click();
 await chip(page,'tag','healthy').click();assert.ok(!(await page.evaluate(()=>familyRecipeRows().map(r=>r.name))).includes('Rau muống xào tỏi'),'Healthy is not every quick stir-fry');await chip(page,'tag','healthy').click();
 // 2. Chip + search (IME) + pagination reset; the input element is never re-rendered.
 /* v1.7.10: 65 vegetarian recipes fill two pages (vegan has 37 now) */await chip(page,'tag','vegetarian').click();await page.locator('[data-fm="load-more"]').first().click();assert.match(await page.locator('#family-recipe-results').innerText(),/Đang hiện 40\//);
 await page.evaluate(()=>{document.querySelector('#family-recipe-search').dataset.same='1'});await page.locator('#family-recipe-search').click();const cdp=await context.newCDPSession(page);await imeType(cdp,[['d','da','đa','đậ','đậu']]);await settle(page);
 assert.equal(await page.locator('#family-recipe-search[data-same="1"]').inputValue(),'đậu');let want=await expected(page,'samples','vegetarian','tag','đậu');assert.ok(want>0&&want<counts['samples:vegetarian']);assert.equal(await statusCount(page),want,'chip + search count');assert.doesNotMatch(await page.locator('#family-recipe-results').innerText(),/Đang hiện 40\//,'search resets to the first page');
 assert.ok((await page.evaluate(()=>familyRecipeRows().map(r=>recipeDiet(r)))).every(d=>['vegan','vegetarian','check'].includes(d)));
 await chip(page,'tag','vegan').click();assert.equal(await page.locator('#family-recipe-search').inputValue(),'đậu','chip keeps the search text');assert.equal(await statusCount(page),await expected(page,'samples','vegan','tag','đậu'));
 await chip(page,'cat','noodle').click();assert.equal(await statusCount(page),await page.evaluate(()=>state.recipes.filter(r=>r.category==='noodle'&&recipeDiet(r)==='vegan'&&recipeSearchScore(r,'đậu')>0).length),'category ∧ tag ∧ search');
 await page.locator('#family-recipe-search').fill('');await settle(page);await chip(page,'cat','all').click();assert.equal(await statusCount(page),await page.evaluate(()=>state.recipes.filter(r=>!ownRecipe(r)).length),'Tất cả resets every chip');
 // Keyboard: Enter/Space on a focused chip toggles it and focus stays on that chip.
 await chip(page,'tag','dressing').focus();await page.keyboard.press('Enter');assert.equal(await chip(page,'tag','dressing').getAttribute('aria-pressed'),'true');assert.equal(await page.evaluate(()=>document.activeElement?.dataset.key),'dressing','focus kept on the chip');await page.keyboard.press('Space');assert.equal(await chip(page,'tag','dressing').getAttribute('aria-pressed'),'false');
 // Screenshots: library with each fixed chip active (VI), and EN labels.
 for(const [kind,key] of CHIPS){await chip(page,kind,key).click();await scrollTo(page,'#family-recipe-search');await page.screenshot({path:`${dir}/${name}-filter-${key}-vi.png`,clip:shotClip});await noOverflow(page,`${name} ${key}`);await chip(page,kind,key).click()}
 await page.evaluate(()=>changeAppLanguage('en'));await page.locator('#family-recipe-chips').waitFor();const labels=await page.locator('#family-recipe-chips').innerText();for(const l of ['Western & Italian','Healthy','Vegetarian','Vegan','Seed & grain salads','Dressings'])assert.ok(labels.includes(l),'EN chip label '+l);
 for(const key of ['vegan','dressing']){await chip(page,'tag',key).click();const s=await page.locator('#family-recipe-status').innerText();assert.match(s,/^\d+ recipes · Reference library · /);assert.equal(await statusCount(page),counts['samples:'+key]);await scrollTo(page,'#family-recipe-search');await page.screenshot({path:`${dir}/${name}-filter-${key}-en.png`,clip:shotClip});await noOverflow(page,name+' EN '+key);await chip(page,'tag',key).click()}
 await page.evaluate(()=>changeAppLanguage('vi'));
 // 3. Meal editor dish search filters both sections live, IME-safe, and keeps ticked dishes.
 await page.evaluate(()=>{location.hash='planner'});await page.locator('.plan-day[open] [data-fm="edit-meal"]').first().waitFor();const mealDate=await page.evaluate(()=>{const d=Object.keys(currentWeek().days)[0];currentWeek().days[d].breakfast.recipes=[];currentWeek().days[d].breakfast.cooked=false;save();render();familyEditMeal(d,'breakfast');return d});await page.locator('#meal-dish-search').waitFor();
 const ownRows=()=>page.locator('#meal-own-list .family-select-row').allInnerTexts(),libRows=()=>page.locator('#meal-lib-list .family-select-row').allInnerTexts(),mealStatus=()=>page.locator('#meal-search-status').innerText();
 assert.equal((await libRows()).length,3,'v1.7.8 ladybug #26 (was 5 in v1.7.5 #11): 3 suggestions before typing, with Xem thêm');assert.equal((await ownRows()).length,3);
