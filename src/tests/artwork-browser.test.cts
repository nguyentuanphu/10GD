const {chromium}=require('playwright'),fs=require('fs'),path=require('path'),assert=require('assert');
(async()=>{const browser=await chromium.launch();const root=process.cwd(),dir='docs/reviews/artwork';for(const [name,width,height]of [['mobile',375,812],['tablet',820,1100],['desktop',1280,800]]){const page=await browser.newPage({viewport:{width,height},reducedMotion:'reduce'});const missing=[];page.on('response',response=>{if(response.url().includes('/artwork/')&&!response.ok())missing.push(response.url())});const errors=[];page.on('pageerror',e=>errors.push(e.message));await page.route('https://kitchen.test/**',async route=>{const url=new URL(route.request().url());if(url.pathname.startsWith('/.netlify/')){const op=url.searchParams.get('op');return route.fulfill({json:op==='status'?{configured:false,connected:false}:op==='state'?{state:null,etag:null}:op==='families'?{families:[]}:{announcements:[],devices:[]}})}let file=path.join(root,url.pathname==='/'?'dist/index.html':url.pathname);if(url.pathname!=='/'&&!url.pathname.startsWith('/docs/')&&!url.pathname.startsWith('/dist/'))file=path.join(root,'dist',url.pathname);try{await route.fulfill({body:fs.readFileSync(file),contentType:({'.html':'text/html','.js':'application/javascript','.json':'application/json','.css':'text/css','.webp':'image/webp','.svg':'image/svg+xml','.png':'image/png'})[path.extname(file)]||'application/octet-stream'})}catch{await route.fulfill({status:404,body:'Missing'})}});
await page.goto('https://kitchen.test/#recipes');await page.locator('#family-recipe-search').waitFor({timeout:15000});await page.locator('[data-fm="samples"]').first().click();await page.locator('#toast.visible').waitFor({state:'hidden',timeout:10000});await page.screenshot({path:`${dir}/${name}-catalog.png`});assert(await page.evaluate(()=>document.documentElement.scrollWidth<=innerWidth+1),'app overflow '+name);
await page.locator('#family-recipe-search').fill('Sườn rim');await page.locator('[data-action="recipe-detail"]').first().click({timeout:3000});await page.locator('.recipe-detail-hero').waitFor();await page.screenshot({path:`${dir}/${name}-detail.png`});assert(await page.evaluate(()=>document.documentElement.scrollWidth<=innerWidth+1),'detail overflow');await page.locator('[data-action="close-modal"]').first().click();
await page.locator('#family-recipe-search').fill('Risotto nấm Parmesan');assert.equal(await page.locator('.recipe-card').count(),1);assert.equal(await page.locator('.recipe-visual [data-art-sheet]').first().getAttribute('data-art-sheet'),'37');await page.locator('[data-action="recipe-detail"]').first().click();assert.match(await page.locator('.recipe-detail-hero').innerText(),/Chưa đủ giá/);assert.ok(await page.locator('.ingredients [data-ingredient-sheet="5"]').count());await page.screenshot({path:`${dir}/${name}-western-new.png`});await page.locator('[data-action="close-modal"]').first().click();await page.locator('#family-recipe-search').fill('Bowl quinoa gà bông cải chanh vàng');assert.equal(await page.locator('.recipe-card').count(),1);await page.screenshot({path:`${dir}/${name}-healthy-new.png`});await page.locator('#family-recipe-search').fill('Bolognese');await page.locator('#app-language').click();await page.waitForFunction(()=>document.documentElement.lang==='en');assert.equal(await page.locator('.recipe-visual .composed-dish').count(),0);assert.match(await page.locator('.recipe-visual [role="img"]').first().getAttribute('aria-label'),/^Recipe illustration:/);await page.screenshot({path:`${dir}/${name}-english.png`});await page.locator('#app-language').click();await page.evaluate(()=>{location.hash='shopping'});await page.waitForTimeout(200);await page.screenshot({path:`${dir}/${name}-shopping.png`});
await page.goto('https://kitchen.test/docs/reviews/artwork/gallery.html');await page.locator('article').first().waitFor();assert.equal(await page.locator('[data-art-sheet]').count(),640);await page.locator('#search').fill('Bolognese');await page.screenshot({path:`${dir}/${name}-composition.png`});assert(await page.evaluate(()=>document.documentElement.scrollWidth<=innerWidth+1),'gallery overflow');assert.equal(errors.length,0,errors.join('\n'));assert.deepEqual(missing,[],'missing artwork requests');assert.equal(await page.locator('svg.composed-dish').count(),0);console.log('PASS',name,width,height,'catalog, details, shopping, gallery search, no overflow or runtime errors');await page.close();}await browser.close()})().catch(e=>{console.error(e);process.exit(1)});
