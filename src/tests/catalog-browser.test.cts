// v1.5 catalog browser review: IME-safe recipe search, ranking, scopes, pantry with family ingredients, weekly menu,
// availability calendar contrast (light/dark), newer-edition sync guard. Saves screenshots for mobile/tablet/desktop.
const {chromium}=require('playwright'),fs=require('fs'),path=require('path'),assert=require('assert');
const root=process.cwd(),dir='docs/reviews/v1.5/catalog';fs.mkdirSync(dir,{recursive:true});
const types={'.html':'text/html','.js':'application/javascript','.json':'application/json','.css':'text/css','.webp':'image/webp','.svg':'image/svg+xml','.png':'image/png','.webmanifest':'application/manifest+json'};
async function route(page){await page.route('https://kitchen.test/**',async r=>{const url=new URL(r.request().url());if(url.pathname.startsWith('/.netlify/')){const op=url.searchParams.get('op');return r.fulfill({json:op==='status'?{configured:false,connected:false}:op==='state'?{state:null,etag:null}:op==='families'?{families:[]}:{announcements:[],devices:[]}})}const file=path.join(root,'dist',url.pathname==='/'?'index.html':url.pathname);try{await r.fulfill({body:fs.readFileSync(file),contentType:types[path.extname(file)]||'application/octet-stream'})}catch{await r.fulfill({status:404,body:'Missing'})}})}
// Simulates a Vietnamese IME (Telex/Gboard/iOS): each word is composed progressively, then committed.
async function imeType(page,cdp,words){for(const [i,steps] of words.entries()){for(const t of steps)await cdp.send('Input.imeSetComposition',{text:t,selectionStart:t.length,selectionEnd:t.length});await cdp.send('Input.insertText',{text:steps[steps.length-1]});if(i<words.length-1)await cdp.send('Input.insertText',{text:' '})}}
const results=page=>page.locator('#family-recipe-results .recipe-card h3').allInnerTexts();
const settle=page=>page.waitForTimeout(350);
const noOverflow=async(page,label)=>assert(await page.evaluate(()=>document.documentElement.scrollWidth<=innerWidth+1),'horizontal overflow: '+label);
const contrast=page=>page.evaluate(()=>{const parse=c=>c.match(/[\d.]+/g).map(Number),lum=c=>{const f=v=>{v/=255;return v<=.03928?v/12.92:((v+.055)/1.055)**2.4};return .2126*f(c[0])+.7152*f(c[1])+.0722*f(c[2])};return Math.min(...[...document.querySelectorAll('.calendar-day')].map(el=>{const cs=getComputedStyle(el),a=lum(parse(cs.color)),b=lum(parse(cs.backgroundColor));return (Math.max(a,b)+.05)/(Math.min(a,b)+.05)}))});
const scrollTo=(page,sel)=>page.evaluate(sel=>{const el=document.querySelector(sel);if(el)window.scrollTo(0,el.getBoundingClientRect().top+scrollY-70)},sel);
const theme=(page,mode)=>page.evaluate(m=>{localStorage.setItem('bep-theme-mode',m);applyThemePreferences()},mode);
(async()=>{const browser=await chromium.launch(process.env.BEP_CHROMIUM?{executablePath:process.env.BEP_CHROMIUM}:{});
for(const [name,width,height] of [['mobile',375,812],['tablet',820,1100],['desktop',1280,800]]){
 const page=await browser.newPage({viewport:{width,height},reducedMotion:'reduce'}),errors=[];page.on('pageerror',e=>errors.push(e.message));await route(page);
 await page.goto('https://kitchen.test/#recipes');await page.locator('#family-recipe-search').waitFor({timeout:20000});await theme(page,'light');
 await page.evaluate(()=>{state.ingredientCatalog={'family-ing-la-lot':{name:'Lá lốt',unit:'g',group:'veg'}};hydrateFamilyIngredients(state);state.pantry.push({id:'lot-la-lot',ingredient:'family-ing-la-lot',qty:120,place:'fridge',expiry:''});state.recipes.push({id:'family-own-1',name:'Chả lá lốt nhà mình',category:'main',protein:'pork',time:30,servings:4,yield:4,ingredients:[{id:'pork',qty:400},{id:'family-ing-la-lot',qty:100}],prep:'Rửa lá lốt.',steps:['Trộn thịt.','Cuốn lá.','Áp chảo.'],favorite:false,custom:true,origin:'family',purposes:['main']});save();render()});
 await page.locator('[data-fm="samples"]').first().click();await page.locator('#toast.visible').waitFor({state:'hidden',timeout:10000});const cdp=await page.context().newCDPSession(page);
 await page.evaluate(()=>{document.querySelector('#family-recipe-search').dataset.sameInput='1'});await page.locator('#family-recipe-search').click();
 await imeType(page,cdp,[['c','ca','cá'],['k','kh','kho']]);await settle(page);
 assert.equal(await page.locator('#family-recipe-search').inputValue(),'cá kho','composition text stays intact');assert.equal(await page.locator('#family-recipe-search[data-same-input="1"]').count(),1,'input element is not re-rendered while typing');
 let rows=await results(page);assert.ok(rows.length>0,'cá kho returns results');assert.match(rows[0],/^Cá kho/,'exact accented phrase ranks first: '+rows[0]);
 await scrollTo(page,'.filter-bar');await page.screenshot({path:`${dir}/${name}-search-vi.png`});await noOverflow(page,name+' search');
 await page.locator('#family-recipe-search').fill('');await settle(page);await page.locator('#family-recipe-search').click();await imeType(page,cdp,[['c','ca','can','canh'],['c','ch','chu','chua']]);await settle(page);
 rows=await results(page);assert.equal(await page.locator('#family-recipe-search').inputValue(),'canh chua');assert.ok(rows.length>0&&/^Canh chua/i.test(rows[0]),'canh chua first: '+rows[0]);
 await page.locator('#family-recipe-search').fill('cá');await settle(page);rows=await results(page);assert.ok(rows.slice(0,8).every(t=>/(^|\s)cá(\s|$)/i.test(t)),'cá dishes rank above cà/cải: '+rows.slice(0,8));
 await page.locator('#family-recipe-search').fill('ca kho');await settle(page);assert.ok((await results(page)).some(t=>/Cá kho/.test(t)),'accent-insensitive match');
 await page.locator('#family-recipe-search').fill('lá lốt');await settle(page);rows=await results(page);assert.ok(rows.includes('Chả lá lốt nhà mình'),'family recipe findable from the reference tab via its ingredient');assert.ok(await page.locator('.family-own-pill').count());
 await page.locator('[data-fm="own"]').first().click();assert.equal(await page.locator('#family-recipe-search').inputValue(),'lá lốt','search text kept when switching tabs');
 await page.locator('[data-fm="all"]').first().click();assert.equal(await page.locator('#family-recipe-search').inputValue(),'lá lốt');assert.ok((await results(page)).includes('Chả lá lốt nhà mình'));
 assert.match(await page.locator('.tabbar').innerText(),/Kho tham khảo \(740\)/,'reference count is computed');
 await page.evaluate(()=>changeAppLanguage('en'));await page.locator('#family-recipe-search').fill('sour soup');await settle(page);rows=await results(page);assert.ok(rows.length>0,'English search matches translated names');await scrollTo(page,'.filter-bar');await page.screenshot({path:`${dir}/${name}-search-en.png`});await noOverflow(page,name+' EN');await page.evaluate(()=>changeAppLanguage('vi'));
 // Pantry and recipe details with a family-added ingredient must render without errors.
 await page.evaluate(()=>{location.hash='pantry'});await page.waitForTimeout(400);assert.ok(await page.locator('[data-ing="family-ing-la-lot"]').count(),'family ingredient lot is listed');await page.locator('[data-ing="family-ing-la-lot"]').first().scrollIntoViewIfNeeded();await page.screenshot({path:`${dir}/${name}-pantry-family.png`});await noOverflow(page,name+' pantry');
 await page.locator('[data-ing="family-ing-la-lot"]').first().click();await page.waitForTimeout(200);await page.evaluate(()=>closeModal());await page.evaluate(()=>{location.hash='pantry'});await page.waitForTimeout(300);await page.locator('[data-action="use-ingredient"][data-id="family-ing-la-lot"]').first().click();await settle(page);assert.equal(await page.locator('#family-recipe-search').inputValue(),'Lá lốt');assert.ok((await results(page)).includes('Chả lá lốt nhà mình'),'pantry Find recipes works for a family ingredient');await page.evaluate(()=>showRecipe('family-own-1'));await page.locator('.recipe-detail-hero').waitFor();await page.evaluate(()=>closeModal());
 // Weekly menu after the distribution fix: Vietnamese-first, no dressing in any slot.
 await page.evaluate(()=>{familyGenerate(state,weekStart);save();location.hash='planner'});await page.waitForTimeout(500);assert.equal(await page.evaluate(()=>Object.values(currentWeek().days).flatMap(d=>MEAL_TYPES.flatMap(t=>d[t]?.recipes||[])).filter(r=>r.recipeKind==='dressing').length),0);await scrollTo(page,'.family-meal-card');await page.screenshot({path:`${dir}/${name}-weekly-menu.png`});await noOverflow(page,name+' planner');
 // Monthly availability calendar in light and dark.
 for(const mode of ['light','dark']){await theme(page,mode);await page.evaluate(()=>{location.hash='today';availabilityModal()});await page.locator('.calendar-day').first().waitFor();await page.locator('.calendar-day').nth(10).click();const ratio=await contrast(page);assert.ok(ratio>=4.5,`${mode} calendar contrast ${ratio.toFixed(2)}`);await page.screenshot({path:`${dir}/${name}-calendar-${mode}.png`});await noOverflow(page,name+' calendar '+mode);await page.evaluate(()=>closeModal())}
 await theme(page,'light');
 if(name==='desktop'){// Newer edition in shared state: pause sync and ask to reload; never offer "use this device's copy".
  await page.evaluate(()=>sessionStorage.setItem('bep-edition-reload',String(APP_EDITION)));
  const blocked=await page.evaluate(()=>{const before=state;try{persistRemoteState({...clone(state),appEdition:APP_EDITION+1});return 'persisted'}catch(e){return {msg:e.message,kept:state===before,flag:cloudConnection.newerEdition}}});assert.equal(blocked.kept,true);assert.equal(blocked.flag,true);assert.match(blocked.msg,/Có bản cập nhật/);
  assert.match(await page.locator('#modal-root').innerText(),/Có bản cập nhật — tải lại/);await page.evaluate(()=>closeModal());
  await page.evaluate(()=>{window.fetchFamilyState=async()=>({etag:'x',state:{...clone(state),appEdition:APP_EDITION+1}})});await page.evaluate(()=>loadRemoteConflict());await page.waitForTimeout(200);assert.equal(await page.locator('[data-feature="cloud-use-local"]').count(),0,'no keep-mine overwrite for a newer edition');assert.ok(await page.locator('[data-feature="reload-app"]').count());await page.evaluate(()=>closeModal())}
 assert.deepEqual(errors,[],name+' page errors');await page.close()}
await browser.close();console.log('PASS IME-safe Vietnamese recipe search (cá kho, canh chua), accent-aware ranking, All/family/reference scopes, EN search, pantry and details with a family ingredient, Vietnamese-first weekly menu, light/dark calendar contrast, newer-edition sync guard at 375/820/1280')})().catch(e=>{console.error(e);process.exit(1)});
