 if(op==='alert-read'&&request.method==='POST'){const data=await request.json(),family=await store.get('state',{type:'json'});if(!/^[a-zA-Z0-9-]{8,100}$/.test(data.id||'')||!family?.members?.some(m=>m.id===data.memberId)||accountContext&&data.memberId!==accountContext.member.memberId)return json({error:'Invalid member or message.'},400);const alert=await updateAnnouncement(store,data.id,r=>({...r,readBy:{...r.readBy,[data.memberId]:new Date().toISOString()}}));return alert?json({alert}):json({error:'Message not found.'},404)}
