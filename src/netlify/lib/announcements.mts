const key=id=>'family-alert/'+id;
const pause=attempt=>new Promise(resolve=>setTimeout(resolve,Math.min(400,20*2**attempt)*(0.5+Math.random())));
export async function updateAnnouncement(store,id,change){for(let i=0;i<8;i++){const result=await store.getWithMetadata(key(id),{type:'json'});if(!result?.data)return null;const next=change(result.data);if(next===undefined)return result.data;const saved=await store.setJSON(key(id),next,{onlyIfMatch:result.etag});if(saved.modified)return next;await pause(i)}throw Error('Announcement changed concurrently')}
// Conditional writes with exponential backoff + jitter. Idempotent: an id already in the index is left in place.
export async function indexAnnouncement(store,id){for(let i=0;i<10;i++){const result=await store.getWithMetadata('family-alert-index',{type:'json'}),current=Array.isArray(result?.data)?result.data:[];if(current.includes(id))return;const ids=[id,...current].slice(0,100);const saved=await store.setJSON('family-alert-index',ids,result?.etag?{onlyIfMatch:result.etag}:{onlyIfNew:true});if(saved.modified)return;await pause(i)}throw Error('Announcement index busy')}
// A retry with the same id (for example after a timeout) re-checks the index so a saved message is always listed.
export async function createAnnouncement(store,record){const result=await store.setJSON(key(record.id),record,{onlyIfNew:true});if(!result.modified){const existing=await store.get(key(record.id),{type:'json'});if(existing)await indexAnnouncement(store,record.id);return{created:false,record:existing}}await indexAnnouncement(store,record.id);return{created:true,record}}
export const getAnnouncement=(store,id)=>store.get(key(id),{type:'json'});
export async function listAnnouncements(store){const ids=await store.get('family-alert-index',{type:'json'})||[];const records=await Promise.all(ids.slice(0,100).map(id=>store.get(key(id),{type:'json'})));return records.filter(Boolean).sort((a,b)=>b.createdAt.localeCompare(a.createdAt)).slice(0,50)}
