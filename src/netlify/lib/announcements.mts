const key=id=>'family-alert/'+id;
export async function updateAnnouncement(store,id,change){for(let i=0;i<5;i++){const result=await store.getWithMetadata(key(id),{type:'json'});if(!result?.data)return null;const next=change(result.data),saved=await store.setJSON(key(id),next,{onlyIfMatch:result.etag});if(saved.modified)return next}throw Error('Announcement changed concurrently')}
async function indexAnnouncement(store,id){for(let i=0;i<5;i++){const result=await store.getWithMetadata('family-alert-index',{type:'json'}),ids=[id,...(result?.data||[]).filter(x=>x!==id)].slice(0,100);const saved=await store.setJSON('family-alert-index',ids,result?.etag?{onlyIfMatch:result.etag}:{onlyIfNew:true});if(saved.modified)return}throw Error('Announcement index busy')}
export async function createAnnouncement(store,record){const result=await store.setJSON(key(record.id),record,{onlyIfNew:true});if(!result.modified)return{created:false,record:await store.get(key(record.id),{type:'json'})};await indexAnnouncement(store,record.id);return{created:true,record}}
export async function listAnnouncements(store){const ids=await store.get('family-alert-index',{type:'json'})||[];const records=await Promise.all(ids.slice(0,100).map(id=>store.get(key(id),{type:'json'})));return records.filter(Boolean).sort((a,b)=>b.createdAt.localeCompare(a.createdAt)).slice(0,50)}
