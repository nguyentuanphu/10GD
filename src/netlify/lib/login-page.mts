export function loginPage(){return `<!doctype html><html lang="vi"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><meta name="bep-release" content="20261031-combined-a2c52fe"><meta name="theme-color" content="#174e3c"><title>Đăng nhập · Bếp Gia Đình</title><style>*{box-sizing:border-box}body{margin:0;min-height:100dvh;display:grid;place-items:center;padding:20px;background:#faf9f5;color:#273d33;font:16px/1.6 system-ui,-apple-system,sans-serif}main{width:100%;max-width:420px;background:#fffefa;border:1px solid #e7e7df;border-radius:20px;padding:26px}h1{font-size:25px;margin:0 0 6px}p,small{color:#657363;font-size:13px}label{display:block;font-size:14px;margin:12px 0 6px}input:not([type=checkbox]),select{width:100%;font:inherit;padding:11px;border:1px solid #ced7c8;border-radius:8px}.trust{display:flex;gap:9px;align-items:flex-start;font-size:13px;margin:15px 0}.trust input{width:20px;height:20px;flex-shrink:0;accent-color:#174e3c}button{background:#174e3c;color:white;border:0;border-radius:8px;padding:11px;font:600 14px system-ui;min-height:44px;cursor:pointer}button:disabled{opacity:.6}.tabs{display:flex;gap:6px;flex-wrap:wrap;margin:18px 0}.tabs button{background:#edf3e9;color:#174e3c;flex:1}.tabs button[aria-pressed=true]{background:#174e3c;color:white}#submit{width:100%;margin-top:12px}#error{color:#9a3f31;min-height:24px;font-size:14px;margin-top:12px}#recovery{background:#edf3e9;padding:15px;border-radius:8px;overflow-wrap:anywhere}code{font-size:17px;user-select:all}small{display:block;margin-top:14px}[hidden]{display:none!important}</style></head><body><main><h1>Bếp Gia Đình</h1><p>Không gian riêng, bữa cơm chung.<br>Your own space, shared family meals.</p><div class="tabs" aria-label="Cách đăng nhập"><button type="button" data-mode="legacy" aria-pressed="true">Gia đình cũ</button><button type="button" data-mode="login" aria-pressed="false">Tài khoản</button><button type="button" data-mode="register" aria-pressed="false">Đăng ký</button></div><form id="login"><div id="account-fields" hidden><label for="username">Tên đăng nhập / Username</label><input id="username" name="username" autocomplete="username" pattern="[a-zA-Z0-9][a-zA-Z0-9_.-]{2,39}" maxlength="40"><small>3–40 ký tự: chữ không dấu, số, dấu chấm, gạch ngang.</small></div><div id="name-field" hidden><label for="name">Tên hiển thị / Display name</label><input id="name" name="name" autocomplete="nickname" maxlength="80"></div><div id="recovery-field" hidden><label for="recoveryCode">Mã khôi phục / Recovery code</label><input id="recoveryCode" name="recoveryCode" autocomplete="off" maxlength="80"></div><label for="password" id="password-label">Mật khẩu gia đình</label><input id="password" type="password" name="password" autocomplete="current-password" required><label class="trust"><input type="checkbox" name="trust"><span>Tin cậy trình duyệt này · nhớ đăng nhập 30 ngày</span></label><button id="submit">Đăng nhập</button><div id="error" role="status" aria-live="polite"></div></form><div id="recovery" hidden><b>Lưu mã khôi phục ở nơi riêng / Save your recovery code</b><p>Chỉ hiện lần này. Chưa kết nối email khôi phục.</p><code id="recovery-value"></code><button type="button" id="continue">Tôi đã lưu · Continue</button></div><button type="button" id="forgot" style="margin-top:14px;background:transparent;color:#174e3c">Quên mật khẩu tài khoản?</button><small>Sau khi đăng nhập và tải đủ, app dùng được offline trong thời hạn phiên. Không ghi nhớ trên thiết bị dùng chung. Quyền được kiểm tra lại khi có mạng. Dữ liệu gia đình cũ vẫn được giữ.</small></main><script>
let mode='legacy';const $=s=>document.querySelector(s);function changeMode(next){mode=next;$('#account-fields').hidden=mode==='legacy';$('#username').required=mode!=='legacy';$('#name-field').hidden=mode!=='register';$('#name').required=mode==='register';$('#recovery-field').hidden=mode!=='recover';$('#recoveryCode').required=mode==='recover';$('#password-label').textContent=mode==='legacy'?'Mật khẩu gia đình':mode==='recover'?'Mật khẩu mới (12–128 ký tự)':'Mật khẩu tài khoản';$('#password').minLength=['register','recover'].includes(mode)?12:0;$('#password').maxLength=128;$('#password').autocomplete=['register','recover'].includes(mode)?'new-password':'current-password';$('#submit').textContent=mode==='register'?'Tạo tài khoản':mode==='recover'?'Đổi bằng mã khôi phục':'Đăng nhập';$('#error').textContent='';document.querySelectorAll('[data-mode]').forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.mode===mode)))}document.querySelectorAll('[data-mode]').forEach(b=>b.onclick=()=>changeMode(b.dataset.mode));$('#forgot').onclick=()=>changeMode('recover');$('#continue').onclick=()=>mode==='recover'?location.replace('/login'):location.replace('/');document.querySelector('#login').addEventListener('submit',async event=>{event.preventDefault();const button=$('#submit'),error=$('#error');button.disabled=true;error.textContent='';try{const form=new FormData(event.target),endpoint=mode==='legacy'?'family?op=login':'accounts?op='+mode,res=await fetch('/.netlify/functions/'+endpoint,{method:'POST',credentials:'same-origin',headers:{'Content-Type':'application/json'},body:JSON.stringify({username:form.get('username'),name:form.get('name'),password:form.get('password'),recoveryCode:form.get('recoveryCode'),trust:form.has('trust')})}),data=await res.json();if(!res.ok){error.textContent=data.error||'Chưa đăng nhập được.';return}$('#password').value='';try{localStorage.removeItem('bep-local-locked')}catch{}if(data.recoveryCode){$('#login').hidden=true;$('#recovery').hidden=false;$('#recovery-value').textContent=data.recoveryCode;return}const target=new URLSearchParams(location.search).get('return')||'/';location.replace(target.startsWith('/')&&!target.startsWith('//')&&!target.startsWith('/login')&&!target.startsWith('/.netlify/')?target+location.hash:'/'+location.hash)}catch(e){error.textContent='Chưa kết nối được. Thử lại khi có mạng.'}finally{button.disabled=false}});</script></body></html>`}
