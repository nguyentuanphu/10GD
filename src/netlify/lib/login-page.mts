import {loginClient} from './login-client.mjs';
export function loginPage(){return `<!doctype html>
<html lang="vi"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><meta name="referrer" content="no-referrer"><meta name="bep-release" content="20261031-family-hub"><meta name="theme-color" content="#174e3c"><title>Đăng nhập · Bếp Gia Đình</title>
<style>
*{box-sizing:border-box}body{margin:0;min-height:100svh;padding:24px 16px 32px;background:#faf9f5;color:#273d33;font:16px/1.5 system-ui,-apple-system,sans-serif}main{width:100%;max-width:440px;margin:0 auto;background:#fffefa;border:1px solid #e7e7df;border-radius:20px;padding:24px}h1{font-size:25px;margin:0 0 6px}p,small{color:#657363;font-size:13px}p{margin:8px 0}label{display:block;font-size:14px;margin:0 0 6px}input:not([type=checkbox]){width:100%;height:48px;font:16px system-ui;padding:11px;border:1px solid #ced7c8;border-radius:8px}button,.button{background:#174e3c;color:white;border:0;border-radius:8px;padding:12px;font:600 14px system-ui;min-height:48px;cursor:pointer}button:disabled{opacity:.6;cursor:wait}.tabs{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin:20px 0}.tabs button{background:#edf3e9;color:#174e3c}.tabs button[aria-selected=true]{background:#174e3c;color:white}.auth-body{min-height:540px}.auth-panel{min-height:540px}#login{display:grid;grid-template-rows:110px 90px 116px 64px 48px 88px;align-content:start}.field small{display:block;min-height:36px;font-size:12px;margin-top:4px}.optional-slot{position:relative;min-height:116px}.optional-slot>div{position:absolute;inset:0}.trust{display:flex;gap:10px;align-items:flex-start;font-size:13px;margin:0;padding:5px 0}.trust input{width:22px;height:22px;flex-shrink:0;accent-color:#174e3c}#submit{width:100%}#error{color:#9a3f31;min-height:72px;max-height:88px;overflow:auto;font-size:14px;padding-top:10px}#recovery{background:#edf3e9;padding:18px;border-radius:10px;overflow-wrap:anywhere}code{display:block;font-size:17px;user-select:all;padding:14px 0}#continue{margin-top:12px;width:100%}.secondary{width:100%;background:transparent;color:#174e3c;margin-top:10px}.note{display:block;min-height:66px;font-size:12px;color:#657363;margin-top:12px}#mode-note{color:#657363;font-size:13px;margin:4px 0 0}.auth-panel[hidden],div[hidden]{display:none!important}@media(max-width:360px){body{padding:16px 12px}main{padding:20px}.tabs button{padding-inline:8px}}
</style></head><body><main>
<a href="/" class="button" style="display:inline-block;text-decoration:none;margin-bottom:16px">Dùng ngay · không cần tài khoản</a><h1 style="display:flex;align-items:center;gap:10px"><img src="/family-logo.png" width="38" height="38" alt="">Bếp Gia Đình</h1><p>Không gian riêng, bữa cơm chung.<br>Your own space, shared family meals.</p>
<div class="tabs" role="tablist" aria-label="Tài khoản"><button type="button" id="login-tab" role="tab" data-mode="login" aria-selected="true" aria-controls="login">Đăng nhập</button><button type="button" id="register-tab" role="tab" data-mode="register" aria-selected="false" aria-controls="login">Đăng ký</button></div>
