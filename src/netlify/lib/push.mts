 if(!selected.length)return{accepted:0,failed:0,recipients:0,...skipped,reason:!candidates.length?'no_device':!live.length?'needs_resubscribe':!wanted.length?'no_recipient':'quiet_hours'};
 let accepted=0,failed=0,suppressed=0,resubscribe=0,expired=0;const origin=subject||process.env.URL||'https://bep-gia-dinh.example';
 const options=pushOptions(message,{automatic});
 await Promise.allSettled(selected.map(async device=>{let dailySlot=null;if(automatic){for(let n=0;n<2;n++){const key='push/daily/'+clock.date+'/'+device.deviceId+'/'+n,claim=await store.setJSON(key,{at:now.toISOString()},{onlyIfNew:true});if(claim.modified){dailySlot=key;break}}if(!dailySlot){suppressed++;return}}const payload=pushPayload(message,device.language);try{await send(device.subscription,payload,{vapidDetails:{subject:origin,publicKey:keys.publicKey,privateKey:keys.privateKey},...options});accepted++}catch(error){failed++;const status=Number(error?.statusCode)||0;if([404,410].includes(status))expired++;console.warn('Push delivery failed',JSON.stringify({status,type:message.type,body:String(error?.body||error?.message||'').slice(0,200)}));try{if(dailySlot)await store.delete(dailySlot);if([404,410].includes(status))await store.delete(device.key);else if(status===403){resubscribe++;const{key:_key,...record}=device;await store.setJSON(device.key,{...record,needsResubscribe:true,failedAt:now.toISOString()})}}catch{}}}));
