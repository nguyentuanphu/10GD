import {resolveAccount} from './accounts.mjs';
const cities={sydney:{name:'Sydney',latitude:-33.8688,longitude:151.2093,zone:'Australia/Sydney'},hanoi:{name:'Hà Nội',latitude:21.0285,longitude:105.8542,zone:'Asia/Ho_Chi_Minh'},hcm:{name:'TP. Hồ Chí Minh',latitude:10.8231,longitude:106.6297,zone:'Asia/Ho_Chi_Minh'}};
export function createWeatherHandler({getStoreFn,fetchFn=fetch,nowFn=()=>Date.now()}={}){return async request=>{const json=(data,status=200)=>Response.json(data,{status,headers:{'Cache-Control':'private, no-store'}});try{if(request.method!=='GET')return json({error:'GET required'},405);const account=await resolveAccount(request,getStoreFn);if(!account)return json({error:'Cần đăng nhập.'},401);const id=new URL(request.url).searchParams.get('city'),city=Object.hasOwn(cities,id)?cities[id]:null;if(!city)return json({error:'Chọn thành phố trong danh sách.'},400);const store=getStoreFn({name:'bep-weather',consistency:'strong',region:'ap-southeast-2'}),cached=await store.get(id,{type:'json'}),now=nowFn();if(cached&&now-cached.fetchedAt<1200000)return json(cached);const url=new URL('https://api.open-meteo.com/v1/forecast');url.search=new URLSearchParams({latitude:String(city.latitude),longitude:String(city.longitude),current:'temperature_2m',timezone:city.zone,timeformat:'unixtime'}).toString();const res=await fetchFn(url,{signal:AbortSignal.timeout(5000)});if(!res.ok)throw Error('weather');const body=await res.json(),temp=body.current?.temperature_2m,time=body.current?.time;if(!Number.isFinite(temp)||!Number.isFinite(time)||Math.abs(now-time*1000)>7200000)throw Error('stale weather');const record={city:city.name,temp,time:new Intl.DateTimeFormat('vi-VN',{hour:'2-digit',minute:'2-digit',timeZone:city.zone}).format(new Date(time*1000)),fetchedAt:now,source:'Open-Meteo'};await store.setJSON(id,record);return json(record)}catch{return json({error:'Chưa có thời tiết mới. Lời chào vẫn dùng lịch bữa ăn.'},503)}}}
