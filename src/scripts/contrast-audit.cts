// Contrast audit (WCAG AA): loads each main view and key modals at 1280×800 and 375×812 in the chosen theme, computes the
// contrast of every visible text element against its composited background and writes a per-selector summary.
// Usage: npm run build && node scripts/contrast-audit.cjs [out.json] [dark|light]. Disabled controls are reported but exempt.
const ROOT=process.cwd();
const {chromium}=require('playwright'),fs=require('fs'),path=require('path');
async function open(browser,{width=375,height=812,theme,hash='today',state,colorScheme='light',lang}={}){
 const ctx=await browser.newContext({viewport:{width,height},reducedMotion:'reduce',colorScheme});const page=await ctx.newPage();page.errors=[];page.on('pageerror',e=>page.errors.push(e.message+'\n'+(e.stack||'').split('\n').slice(0,4).join('\n')));page.on('console',m=>{if(m.type()==='error')page.errors.push('console: '+m.text())});
 await page.route('https://kitchen.test/**',async route=>{const url=new URL(route.request().url());if(url.pathname.startsWith('/.netlify/')){const op=url.searchParams.get('op');return route.fulfill({json:op==='status'?{configured:false,connected:false}:op==='state'?{state:null,etag:null}:op==='families'?{families:[]}:{announcements:[],devices:[]}})}let file=path.join(ROOT,'dist',url.pathname==='/'?'index.html':url.pathname);try{await route.fulfill({body:fs.readFileSync(file),contentType:({'.html':'text/html','.js':'application/javascript','.json':'application/json','.css':'text/css','.webp':'image/webp','.svg':'image/svg+xml','.png':'image/png','.webmanifest':'application/manifest+json'})[path.extname(file)]||'application/octet-stream'})}catch{await route.fulfill({status:404,body:'Missing'})}});
 await page.addInitScript(([state,theme,lang])=>{try{if(state&&!sessionStorage.getItem('seeded')){localStorage.setItem('guest/bep-gia-dinh-v1',state);sessionStorage.setItem('seeded','1')}if(theme)localStorage.setItem('bep-theme-mode',theme);if(lang)localStorage.setItem('guest/bep-language',lang)}catch{}},[state?JSON.stringify(state):null,theme,lang]);
 await page.goto('https://kitchen.test/#'+hash);await page.waitForFunction(()=>typeof state!=='undefined'&&document.querySelector('#main')?.children.length>0,null,{timeout:20000});await page.waitForTimeout(300);return page}
const OUT=process.argv[2]||'docs/reviews/v1.5/catalog/contrast-'+(process.argv[3]||'dark')+'.json',THEME=process.argv[3]||'dark';
const audit=()=>{const parse=c=>{const m=c.match(/rgba?\(([^)]+)\)/);if(!m)return null;const p=m[1].split(/[ ,/]+/).filter(Boolean).map(Number);return[p[0],p[1],p[2],p.length>3?p[3]:1]};
 const over=(top,bot)=>{const a=top[3]+bot[3]*(1-top[3]);if(!a)return[0,0,0,0];return[0,1,2].map(i=>(top[i]*top[3]+bot[i]*bot[3]*(1-top[3]))/a).concat(a)};
 const lum=c=>{const f=v=>{v/=255;return v<=.03928?v/12.92:((v+.055)/1.055)**2.4};return .2126*f(c[0])+.7152*f(c[1])+.0722*f(c[2])};
 const ratio=(a,b)=>{const x=lum(a),y=lum(b);return (Math.max(x,y)+.05)/(Math.min(x,y)+.05)};
 const bgOf=el=>{const layers=[];let image=false;for(let x=el;x;x=x.parentElement){const cs=getComputedStyle(x);const bi=cs.backgroundImage;if(bi&&bi!=='none'){if(/url\(/.test(bi)){image=true;break}const stop=bi.match(/rgba?\([^)]+\)/);if(stop){const c=parse(stop[0]);layers.push(c);if(c[3]>=1)break}}const c=parse(cs.backgroundColor);if(c&&c[3]>0){layers.push(c);if(c[3]>=1)break}}let bg=[255,255,255,1];if(!layers.length||layers[layers.length-1][3]<1)bg=getComputedStyle(document.body).backgroundColor?parse(getComputedStyle(document.documentElement).backgroundColor)||bg:bg;if(bg[3]<1)bg=[255,255,255,1];for(let i=layers.length-1;i>=0;i--)bg=over(layers[i],bg);return{bg,image}};
 const name=el=>{const cls=[...el.classList].slice(0,2).join('.');const p=el.parentElement;const pc=p?[...p.classList].slice(0,1).join('.'):'';return (pc?'.'+pc+' > ':'')+el.tagName.toLowerCase()+(cls?'.'+cls:'')+(el.id?'#'+el.id:'')};
 const out=[];const seen=new Set();
 const walker=document.createTreeWalker(document.body,NodeFilter.SHOW_TEXT);let n;while(n=walker.nextNode()){if(!n.nodeValue.trim())continue;const el=n.parentElement;if(!el||seen.has(el)||el.closest('svg,script,style,[hidden],template'))continue;seen.add(el);const r=el.getBoundingClientRect();if(r.width<1||r.height<1)continue;const cs=getComputedStyle(el);if(cs.visibility==='hidden'||cs.display==='none')continue;let op=1;for(let x=el;x;x=x.parentElement)op*=+getComputedStyle(x).opacity;if(op<.1)continue;
  const {bg,image}=bgOf(el);if(image)continue;let fg=parse(cs.color);if(!fg)continue;fg=over([fg[0],fg[1],fg[2],fg[3]*op],bg);const size=parseFloat(cs.fontSize),bold=+cs.fontWeight>=700,large=size>=24||size>=18.66&&bold;const cr=ratio(fg,bg),need=large?3:4.5;if(cr<need)out.push({sel:name(el),text:n.nodeValue.trim().slice(0,40),ratio:+cr.toFixed(2),need,fg:fg.slice(0,3).map(Math.round).join(','),bg:bg.slice(0,3).map(Math.round).join(',')})}
 return out};
(async()=>{const b=await chromium.launch();const results={};const add=(where,rows)=>{results[where]=rows};
 const views=['today','planner','shopping','recipes','pantry','expenses','insights','products'];
 for(const [w,h] of [[1280,800],[375,812]]){const page=await open(b,{width:w,height:h,theme:THEME,hash:'today'});
  // seed: a family recipe, a family ingredient lot, availability entries, a cooked meal so more UI shows
  await page.evaluate(()=>{state.ingredientCatalog={'family-ing-la-lot':{name:'Lá lốt',unit:'g',group:'veg'}};INGREDIENTS['family-ing-la-lot']=['Lá lốt','g','veg',0,'🌿',null];state.pantry.push({id:'p-x',ingredient:'family-ing-la-lot',qty:100,place:'fridge',expiry:''},{id:'p-y',ingredient:'chicken',qty:500,place:'fridge',expiry:addDays(sydneyDate(),1)});state.recipes.push({id:'fam-1',name:'Chả lá lốt nhà mình',category:'main',protein:'pork',time:30,servings:4,ingredients:[{id:'pork',qty:400},{id:'family-ing-la-lot',qty:100}],prep:'',steps:['Cuốn chả','Áp chảo'],favorite:false,custom:true,origin:'family',purposes:['main']});save();try{familyGenerate(state,weekStart)}catch(e){}save();render()});
  for(const v of views){await page.evaluate(v=>{location.hash=v},v);await page.waitForTimeout(500);add(`${w}:${v}`,await page.evaluate(audit))}
  await page.evaluate(()=>{location.hash='recipes'});await page.waitForTimeout(300);await page.locator('[data-fm="samples"]').first().click().catch(()=>{});await page.waitForTimeout(300);add(`${w}:recipes-samples`,await page.evaluate(audit));
  const modals={availability:()=>availabilityModal(),recipe:()=>showRecipe('r1'),familyRecipe:()=>showRecipe('fam-1'),settings:()=>settingsModal(),busy:()=>typeof busyModal==='function'&&busyModal(),generate:()=>typeof familyGeneratePreview==='function'&&familyGeneratePreview(),editMeal:()=>typeof familyEditMeal==='function'&&familyEditMeal(Object.keys(currentWeek().days)[0],'dinner'),members:()=>typeof manageMembers==='function'&&manageMembers()};
  for(const [k,fn] of Object.entries(modals)){await page.evaluate(`location.hash='today'`);await page.waitForTimeout(200);try{await page.evaluate(`(${fn.toString()})()`);await page.waitForTimeout(400);add(`${w}:modal-${k}`,await page.evaluate(audit))}catch(e){add(`${w}:modal-${k}`,[{error:e.message.slice(0,100)}])}await page.evaluate(()=>typeof closeModal==='function'&&closeModal())}
  await page.context().setOffline(true);await page.evaluate(()=>{window.dispatchEvent(new Event('offline'));location.hash='today'});await page.waitForTimeout(600);add(`${w}:offline-today`,await page.evaluate(audit));await page.context().setOffline(false);
  if(page.errors.filter(e=>!/fetching the script/.test(e)).length)results[`${w}:errors`]=page.errors;await page.context().close()}
 const flat=Object.entries(results).flatMap(([k,rows])=>Array.isArray(rows)?rows.filter(r=>r.sel).map(r=>({...r,where:k})):[]);const bySel={};for(const r of flat){(bySel[r.sel]??={n:0,min:99,where:new Set(),ex:r}).n++;bySel[r.sel].min=Math.min(bySel[r.sel].min,r.ratio);bySel[r.sel].where.add(r.where.split(':')[1])}
 const summary=Object.entries(bySel).sort((a,b)=>b[1].n-a[1].n).map(([sel,o])=>({sel,n:o.n,min:o.min,where:[...o.where].join(','),fg:o.ex.fg,bg:o.ex.bg,text:o.ex.text}));
 fs.writeFileSync(OUT,JSON.stringify({theme:THEME,sizes:['1280x800','375x812'],views:Object.keys(results).length,failures:flat.length,selectors:summary.length,summary,errors:Object.fromEntries(Object.entries(results).filter(([k])=>k.endsWith('errors')))},null,1));console.log('failures',flat.length,'selectors',summary.length);await b.close()})();
