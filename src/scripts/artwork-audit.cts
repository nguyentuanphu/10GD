// Reproducible audit and full visual/design inventory, including the original revision.
const fs=require('node:fs'),vm=require('node:vm'),cp=require('node:child_process');
const escapeHtml=s=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const context=vm.createContext({normalizeText:s=>String(s).normalize('NFD').replace(/[\u0300-\u036f]/g,'').replace(/đ/g,'d').toLowerCase(),esc:escapeHtml,foodArt:()=>'',appLanguage:'vi'});
vm.runInContext(['seed','recipe-catalog','dish-composition','artwork'].map(f=>fs.readFileSync('dist/'+f+'.js','utf8')).join('\n')+'\n;this.catalog={ingredients:INGREDIENTS,recipes:RECIPES};this.ingredientCells=INGREDIENT_ART',context);
const baseline=vm.createContext({foodArt:()=>''});
vm.runInContext(cp.execFileSync('git',['show','0bcef706f1b01260b4c0a5980aa67ad09fc63c95:src/frontend/artwork.ts'],{encoding:'utf8'})+';this.cells=INGREDIENT_ART',baseline);
const {ingredients,recipes}=context.catalog;
const ingredientRows=Object.entries(ingredients).map(([id,record])=>({id,name:record[0],before:baseline.cells[id],after:context.ingredientCells[id],action:baseline.cells[id]===context.ingredientCells[id]?'retain-reference':'replace-ambiguous-or-shared',brief:`Minh họa riêng ${record[0]}; khớp dạng mua/sử dụng trong tên, nền #fffefa, màu tự nhiên, góc 3/4, gouache theo ingredients-v1; không nhãn hay logo.`}));
const dishRows=recipes.map(r=>({id:r.id,name:r.name,category:r.category,ingredients:r.ingredients.map(i=>({id:i.id,name:ingredients[i.id]?.[0]||i.id,qty:i.qty})),rendering:context.dishArtworkCell(r)===null?'ingredient-composition-svg':'reviewed-reference-sheet',review:'illustration-only; recipe-specific human review still required',brief:`${r.name}. ${r.prep} Nguyên liệu: ${r.ingredients.map(i=>ingredients[i.id]?.[0]||i.id).join(', ')}. ${r.steps.join(' ')} Chỉ vẽ món hoàn chỉnh, không tự thêm cơm/đạm/trang trí không có trong công thức. Nền #fffefa, đĩa/bát ngà, gouache màu ấm theo dishes-v1, góc 3/4; không chữ.`,...context.dishCompositionModel(r)}));
const summary={ingredients:ingredientRows.length,recipes:dishRows.length,originalIngredientCells:new Set(Object.values(baseline.cells)).size,originalDishCells:16,ingredientReplacements:ingredientRows.filter(r=>r.action.startsWith('replace')).length,paintedDishReferences:dishRows.filter(r=>r.rendering==='reviewed-reference-sheet').length,composedDishIllustrations:dishRows.filter(r=>r.rendering==='ingredient-composition-svg').length};
fs.mkdirSync('docs/reviews/artwork',{recursive:true});fs.writeFileSync('docs/reviews/artwork/catalog.json',JSON.stringify({summary,ingredients:ingredientRows,dishes:dishRows},null,2)+'\n');
const cards=ingredientRows.map(r=>`<article>${context.ingredientArtwork(r.id)}<h2>${escapeHtml(r.name)}</h2><small>${r.id} · ${r.action}</small></article>`).join('')+recipes.map(r=>`<article>${context.foodArt(r)}<h2>${escapeHtml(r.name)}</h2><small>${r.id} · ${context.dishArtworkCell(r)===null?'Minh họa thành phần SVG':'Artwork tham khảo'}</small><details><summary>Thiết kế / nguyên liệu</summary>${escapeHtml(dishRows.find(d=>d.id===r.id).brief)}</details></article>`).join('');
fs.writeFileSync('docs/reviews/artwork/gallery.html',`<!doctype html><html lang="vi"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Kiểm kê artwork · 10GD</title><link rel="stylesheet" href="../../../dist/styles.css"><style>body{padding:20px;background:#fffefa}main{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(220px,100%),1fr));gap:16px}article{min-width:0;border:1px solid #e0ddcd;padding:16px;border-radius:16px}h2{font-size:16px;overflow-wrap:anywhere}small{overflow-wrap:anywhere}article>.ingredient-art{width:110px;height:110px}.food-illustration{width:180px;max-width:100%;height:180px}.ingredient-sheet{background-image:url('../../../dist/artwork/ingredients-v1.webp')}.ingredient-sheet-2{background-image:url('../../../dist/artwork/ingredients-v2.webp')}.ingredient-sheet-3{background-image:url('../../../dist/artwork/ingredients-v3.webp')}.ingredient-sheet-4{background-image:url('../../../dist/artwork/ingredients-v4.webp')}.dish-sheet{background-image:url('../../../dist/artwork/dishes-v1.webp')}.dish-sheet-2{background-image:url('../../../dist/artwork/dishes-v2.webp')}</style><h1>58 nguyên liệu · 540 món</h1><p>Artwork tham khảo và minh họa thành phần, không phải ảnh chính xác công thức. SVG là thiết kế sơ bộ; chưa tương đương bộ tranh gouache riêng cho từng món.</p><label>Tìm <input id="search" type="search"></label><main>${cards}</main><script>document.querySelector('input').oninput=e=>document.querySelectorAll('article').forEach(a=>a.hidden=!a.textContent.toLowerCase().includes(e.target.value.toLowerCase()))</script></html>`);
console.log(JSON.stringify(summary,null,2));
