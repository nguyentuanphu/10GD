{
  "manifest_version": 3,
  "name": "FamTray So Giá · Price Check",
  "short_name": "So Giá",
  "version": "1.7.2",
  "description": "Ghi lại giá trên trang siêu thị bạn đang xem cho Bếp Gia Đình · Saves the shelf prices you view for your family kitchen.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "alarms", "idle", "tabs", "notifications"],
  "host_permissions": [
    "https://www.woolworths.com.au/*",
    "https://www.coles.com.au/*",
    "https://www.aldi.com.au/*",
    "https://www.chemistwarehouse.com.au/*",
    "https://www.amazon.com.au/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": [
        "https://www.woolworths.com.au/*",
        "https://www.coles.com.au/*",
        "https://www.aldi.com.au/*",
        "https://www.chemistwarehouse.com.au/*",
        "https://www.amazon.com.au/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": { "default_popup": "popup.html", "default_title": "FamTray So Giá · Price Check", "default_icon": { "16": "icon.png", "32": "icon.png", "48": "icon.png", "128": "icon.png" } },
  "icons": { "16": "icon.png", "32": "icon.png", "48": "icon.png", "128": "icon.png" },
  "options_page": "options.html",
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'" }
}
