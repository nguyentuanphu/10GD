{
  "manifest_version": 3,
  "name": "FamTray So sánh giá · Price Compare",
  "short_name": "So sánh giá",
  "version": "1.7.0",
  "description": "Ghi lại giá trên trang siêu thị bạn đang xem cho Bếp Gia Đình · Saves the shelf prices you view for your family kitchen.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "alarms", "idle", "tabs", "notifications"],
  "host_permissions": [
    "https://www.woolworths.com.au/*",
    "https://www.coles.com.au/*",
    "https://www.aldi.com.au/*",
    "https://www.chemistwarehouse.com.au/*",
    "https://www.amazon.com.au/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": [
        "https://www.woolworths.com.au/*",
        "https://www.coles.com.au/*",
        "https://www.aldi.com.au/*",
        "https://www.chemistwarehouse.com.au/*",
        "https://www.amazon.com.au/*"
      ],
      "js": ["build-info.js", "default-config.js", "scout-core.js", "scout-parse.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": { "default_popup": "popup.html", "default_title": "FamTray So sánh giá · Price Compare", "default_icon": { "16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png" } },
  "icons": { "16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png" },
  "options_page": "options.html",
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'" }
}
